package layout

import "ton618/core/internal/ui/icons"

templ SettingsModal() {
    <!-- Settings Modal -->
    <div id="settings-modal" x-data x-show="$store.settings.open" x-cloak
        class="fixed inset-0 z-[100] flex items-center justify-center bg-black/70 backdrop-blur-sm">
        <div
            class="bg-zinc-900 border border-zinc-800 rounded-2xl shadow-2xl w-full max-w-xl md:max-w-3xl mx-4 max-h-[85vh] md:h-[620px] flex flex-col">
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-zinc-800">
                <h2 class="text-base font-bold text-zinc-200 flex items-center gap-2">
                    @icons.Icon(icons.GetIcon("config"), "w-4 h-4 " + icons.GetColor("config")) Configurações
                </h2>
                <button @click="$store.settings.close()"
                    class="text-zinc-500 hover:text-white transition-colors text-xl leading-none">
                    &times;
                </button>
            </div>

            <!-- Wrapper for side-by-side tabs and content on desktop -->
            <div class="flex flex-col md:flex-row flex-1 overflow-hidden">
                <!-- Tabs -->
                <div class="settings-tabs-container flex flex-col gap-1 px-6 md:px-3 pt-4 md:py-6 border-b md:border-b-0 md:border-r border-zinc-800 overflow-x-auto md:overflow-x-visible md:overflow-y-auto scroll-smooth whitespace-nowrap flex-nowrap md:w-44 flex-shrink-0"
                    style="-webkit-overflow-scrolling:touch;">
                    <button @click="$store.settings.openTab('arquivamento')"
                        :class="$store.settings.activeTab === 'arquivamento' ? 'text-white border-sky-500 bg-sky-500/5' : 'text-zinc-400 border-transparent hover:text-zinc-200 hover:bg-zinc-800/30'"
                        class="px-4 py-2 md:px-3.5 md:py-2 text-sm font-semibold border-l-2 border-b-0 md:text-left transition-all flex items-center gap-2 rounded-none">
                        @icons.Icon(icons.GetIcon("arquivamento"), "w-4 h-4 " + icons.GetColor("arquivamento")) Arquivamento
                    </button>
                    <button @click="$store.settings.openTab('restaurar')"
                        :class="$store.settings.activeTab === 'restaurar' ? 'text-white border-sky-500 bg-sky-500/5' : 'text-zinc-400 border-transparent hover:text-zinc-200 hover:bg-zinc-800/30'"
                        class="px-4 py-2 md:px-3.5 md:py-2 text-sm font-semibold border-l-2 border-b-0 md:text-left transition-all flex items-center gap-2 rounded-none">
                        @icons.Icon(icons.GetIcon("restaurar"), "w-4 h-4 " + icons.GetColor("restaurar")) Restaurar
                    </button>
                    <button @click="$store.settings.openTab('backup')"
                        :class="$store.settings.activeTab === 'backup' ? 'text-white border-sky-500 bg-sky-500/5' : 'text-zinc-400 border-transparent hover:text-zinc-200 hover:bg-zinc-800/30'"
                        class="px-4 py-2 md:px-3.5 md:py-2 text-sm font-semibold border-l-2 border-b-0 md:text-left transition-all flex items-center gap-2 rounded-none">
                        @icons.Icon(icons.GetIcon("backup"), "w-4 h-4 " + icons.GetColor("backup")) Backup
                    </button>
                    <button @click="$store.settings.openTab('marcadores')"
                        :class="$store.settings.activeTab === 'marcadores' ? 'text-white border-sky-500 bg-sky-500/5' : 'text-zinc-400 border-transparent hover:text-zinc-200 hover:bg-zinc-800/30'"
                        class="px-4 py-2 md:px-3.5 md:py-2 text-sm font-semibold border-l-2 border-b-0 md:text-left transition-all flex items-center gap-2 rounded-none">
                        @icons.Icon(icons.GetIcon("marcadores"), "w-4 h-4 " + icons.GetColor("marcadores")) Marcadores
                    </button>
                    <button @click="$store.settings.openTab('agenda')"
                        :class="$store.settings.activeTab === 'agenda' ? 'text-white border-sky-500 bg-sky-500/5' : 'text-zinc-400 border-transparent hover:text-zinc-200 hover:bg-zinc-800/30'"
                        class="px-4 py-2 md:px-3.5 md:py-2 text-sm font-semibold border-l-2 border-b-0 md:text-left transition-all flex items-center gap-2 rounded-none">
                        @icons.Icon(icons.GetIcon("settings-agenda"), "w-4 h-4 " + icons.GetColor("settings-agenda")) Agenda
                    </button>
                    <button @click="$store.settings.openTab('ntfy')"
                        :class="$store.settings.activeTab === 'ntfy' ? 'text-white border-sky-500 bg-sky-500/5' : 'text-zinc-400 border-transparent hover:text-zinc-200 hover:bg-zinc-800/30'"
                        class="px-4 py-2 md:px-3.5 md:py-2 text-sm font-semibold border-l-2 border-b-0 md:text-left transition-all flex items-center gap-2 rounded-none">
                        @icons.Icon(icons.GetIcon("ntfy"), "w-4 h-4 " + icons.GetColor("ntfy")) Ntfy
                    </button>
                    <button @click="$store.settings.openTab('semantica')"
                        :class="$store.settings.activeTab === 'semantica' ? 'text-white border-sky-500 bg-sky-500/5' : 'text-zinc-400 border-transparent hover:text-zinc-200 hover:bg-zinc-800/30'"
                        class="px-4 py-2 md:px-3.5 md:py-2 text-sm font-semibold border-l-2 border-b-0 md:text-left transition-all flex items-center gap-2 rounded-none">
                        @icons.Icon(icons.GetIcon("semantica"), "w-4 h-4 " + icons.GetColor("semantica")) Semântica
                    </button>
                </div>

            <!-- Tab Content -->
            <div class="flex-1 overflow-y-auto px-6 py-5 space-y-6">
                <!-- Arquivamento Tab -->
                <div x-show="$store.settings.activeTab === 'arquivamento'" class="space-y-6">
                    <p class="text-sm text-zinc-400">
                        Selecione filtros para encontrar notas, marque quais arquivar e clique em "Arquivar Selecionadas".
                        As notas serão zipadas e movidas para a pasta de arquivos mortos.
                    </p>

                    <form id="bulk-archive-form" hx-post="/api/bulk-delete" hx-target="#bulk-preview-area">
                        <input type="hidden" name="preview" value="true" />
                        <!-- Filtro: Por Tag -->
                        <div class="bg-zinc-800/50 rounded-xl p-4 border border-zinc-700/50 mb-6">
                            <label class="block text-sm font-semibold text-zinc-200 mb-3">Filtrar por tag</label>
                            <label class="block text-xs text-zinc-500 mb-2">Notas que contenham uma ou mais tags (separadas por vírgula):</label>
                            <input type="text" name="tag_name" id="filter-tag-names" placeholder="ex: temporario, rascunho, lixo"
                                class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-sm text-zinc-200 placeholder-zinc-500 focus:outline-none focus:border-sky-500 transition-colors" />
                            <input type="hidden" name="by_tag" value="true" />
                        </div>

                        <button type="submit"
                            class="w-full py-2.5 rounded-xl bg-sky-600 hover:bg-sky-700 text-white text-sm font-bold transition-colors">
                            🔍 Previsualizar Notas
                        </button>
                    </form>

                    <div id="bulk-preview-area" class="mt-6"></div>

                    <!-- Auto-Tagging por Inatividade -->
                    <div class="border-t border-zinc-800 pt-6 mt-6" x-data="autoTagConfig()">
                        <div class="flex items-center gap-2 mb-2">
                            <h3 class="text-sm font-bold text-zinc-200">Auto-Tag</h3>
                        </div>
                        <p class="text-xs text-zinc-500 mb-4 leading-relaxed">
                            Adicione tags automaticamente a notas que não são abertas há um certo número de dias (baseado na última vez que a nota foi aberta). Ao clicar em "Aplicar Tags Agora", a tag é adicionada às notas inativas e removida das que foram abertas recentemente (abaixo dos dias configurados).
                        </p>
                        
                        <div class="space-y-3 mb-4">
                            <template x-for="(rule, index) in rules" :key="index">
                                <div class="flex items-center gap-3 bg-zinc-800/50 p-2 rounded-lg border border-zinc-700/50">
                                    <input type="number" x-model.number="rule.days" min="1" placeholder="Dias" class="w-20 bg-zinc-900 border border-zinc-700 rounded-md px-2 py-1 text-sm text-zinc-200 focus:outline-none focus:border-sky-500" />
                                    <span class="text-xs text-zinc-400">dias</span>
                                    <span class="text-zinc-600">→</span>
                                    <span class="text-zinc-500 text-sm">#</span>
                                    <input type="text" x-model="rule.tag" placeholder="tag" class="flex-1 bg-zinc-900 border border-zinc-700 rounded-md px-2 py-1 text-sm text-zinc-200 focus:outline-none focus:border-sky-500" />
                                    <button type="button" @click="rules.splice(index, 1)" class="text-zinc-500 hover:text-red-400 p-1 rounded-md transition-colors text-xl font-bold leading-none">
                                        &times;
                                    </button>
                                </div>
                            </template>
                        </div>
                        
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <button type="button" @click="rules.push({days: 30, tag: ''})" class="text-xs font-semibold text-sky-400 hover:text-sky-300 transition-colors">
                                + Adicionar Regra
                            </button>
                            <div class="flex items-center gap-2">
                                <button type="button" @click="applyTags()" :disabled="applying"
                                    class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 disabled:bg-emerald-700/40 disabled:cursor-not-allowed text-white text-xs font-bold rounded-lg transition-colors inline-flex items-center gap-2">
                                    <span x-show="!applying">▶️ Aplicar Tags Agora</span>
                                    <span x-show="applying" class="inline-flex items-center gap-2">
                                        <span class="animate-spin h-3 w-3 border-2 border-white border-t-transparent rounded-full"></span>
                                        Aplicando...
                                    </span>
                                </button>
                                <button type="button" @click="saveRules()" class="px-3 py-1.5 bg-sky-600 hover:bg-sky-700 text-white text-xs font-bold rounded-lg transition-colors">
                                    Salvar Regras
                                </button>
                            </div>
                        </div>
                        <p x-show="saved" x-transition.duration.500ms class="text-xs text-emerald-400 mt-2 text-right hidden" :class="{'hidden': false}">✓ Salvo com sucesso!</p>
                        <p x-show="error" x-text="errorMsg" class="text-xs text-red-400 mt-2 text-right hidden" :class="{'hidden': !error}"></p>
                        <p x-show="applyMsg" x-text="applyMsg" x-transition.duration.500ms class="text-xs mt-2 text-right"></p>
                    </div>

                    <!-- Cleanup orphan images -->
                    <div class="border-t border-zinc-800 pt-6 mt-6">
                        <p class="text-[10px] text-zinc-600 mb-3">
                            Imagens enviadas pelo editor que não são mais referenciadas por nenhuma nota podem ser removidas para liberar espaço.
                        </p>
                        <div id="cleanup-result">
                            <button hx-post="/api/cleanup-images" hx-target="#cleanup-result"
                                class="w-full py-2 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-400 hover:text-white text-xs font-semibold transition-colors">
                                🧹 Limpar imagens órfãs
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Restaurar Tab -->
                <div x-show="$store.settings.activeTab === 'restaurar'" class="space-y-6">
                    <p class="text-sm text-zinc-400">
                        Aqui estão os pacotes de arquivos que você arquivou anteriormente. 
                        Ao restaurar, eles voltarão para os diretórios originais e ficarão disponíveis nas buscas.
                    </p>

                    <div id="restore-result-area" hx-get="/api/archives" hx-trigger="load, reload-archives from:body">
                        <div class="text-center py-6">
                            <div class="animate-spin h-5 w-5 border-2 border-zinc-600 border-t-transparent rounded-full mx-auto mb-3"></div>
                            <p class="text-xs text-zinc-500">Carregando arquivos mortos...</p>
                        </div>
                    </div>
                </div>

                <!-- Backup Tab -->
                <div x-show="$store.settings.activeTab === 'backup'" class="space-y-6">
                    <p class="text-sm text-zinc-400">
                        Escolha o tipo de backup ideal para você. O backup rápido contém apenas as notas (incluindo desenhos). O completo inclui também arquivos pesados.
                        Arquivos da pasta
                        <code class="text-zinc-500">archives/</code> não são
                        incluídos.
                    </p>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- Apenas Notas -->
                        <div class="bg-zinc-800/50 rounded-xl p-5 border border-zinc-700/50 flex flex-col justify-between text-center">
                            <div>
                                <div class="text-4xl mb-3">📄</div>
                                <p class="text-sm text-zinc-300 font-bold mb-1">
                                    Apenas Notas (Rápido)
                                </p>
                                <p class="text-xs text-zinc-500 mb-4">
                                    Textos em markdown, meta-dados, dados estruturados.
                                </p>
                            </div>
                            <a id="backup-download-notas-btn" href="/api/backup?full=false" download
                                class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold transition-colors w-full mt-2"
                                onclick="
                                        this.classList.add('opacity-50');
                                        let originalText = this.innerHTML;
                                        this.innerHTML = '⏳ Gerando...';
                                        setTimeout(() => {
                                            this.classList.remove('opacity-50');
                                            this.innerHTML = originalText;
                                        }, 3000);
                                    ">
                                ⬇️ Baixar Rápido
                            </a>
                        </div>

                        <!-- Backup Completo -->
                        <div class="bg-zinc-800/50 rounded-xl p-5 border border-zinc-700/50 flex flex-col justify-between text-center">
                            <div>
                                <div class="text-4xl mb-3">💾</div>
                                <p class="text-sm text-zinc-300 font-bold mb-1">
                                    Backup Completo
                                </p>
                                <p class="text-xs text-zinc-500 mb-4">
                                    Tudo: notas e os arquivos/anexos pesados em disco.
                                </p>
                            </div>
                            <a id="backup-download-full-btn" href="/api/backup?full=true" download
                                class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-700 text-white text-sm font-bold transition-colors w-full mt-2"
                                onclick="
                                        this.classList.add('opacity-50');
                                        let originalText = this.innerHTML;
                                        this.innerHTML = '⏳ Gerando...';
                                        setTimeout(() => {
                                            this.classList.remove('opacity-50');
                                            this.innerHTML = originalText;
                                        }, 10000);
                                    ">
                                ⬇️ Baixar Completo
                            </a>
                        </div>
                    </div>

                    <div class="bg-zinc-800/30 rounded-xl p-4 border border-zinc-700/50">
                        <p class="text-xs text-zinc-500 leading-relaxed">
                            <strong class="text-zinc-400">O que é incluído no Completo:</strong><br />
                            Além das notas (<code class="text-zinc-500">notes</code>):<br />
                            📕 PDFs da pasta <code class="text-zinc-500">pdfs/</code><br />
                            📦 Anexos da pasta <code class="text-zinc-500">attachments/</code>
                        </p>
                    </div>
                </div>


                <!-- Marcadores Tab -->
                <div x-show="$store.settings.activeTab === 'marcadores'" class="space-y-6">
                    <p class="text-sm text-zinc-400">
                        Configure quais palavras-chave aparecem como TODOs na página
                        <a href="/todos" class="text-amber-400 hover:underline">🎯 TODOs</a>.
                        Apenas marcadores <strong>ativos</strong> são detectados nas notas.
                    </p>

                    <div hx-get="/api/todo-markers" hx-trigger="intersect once">
                        <div class="text-center py-8">
                            <div class="animate-spin h-5 w-5 border-2 border-zinc-600 border-t-transparent rounded-full mx-auto mb-3"></div>
                            <p class="text-xs text-zinc-600">Carregando marcadores...</p>
                        </div>
                    </div>
                </div>

                <!-- Agenda Tab -->
                <div x-show="$store.settings.activeTab === 'agenda'" class="space-y-6">
                    <p class="text-sm text-zinc-400">
                        Configure as opções de visualização da sua agenda e linha do tempo.
                    </p>

                    <div class="bg-zinc-800/50 rounded-xl p-4 border border-zinc-700/50 space-y-4">
                        <div>
                            <label class="block text-xs font-semibold text-zinc-300 mb-2">Fuso Horário / Localização (Timezone)</label>
                            <select id="setting-agenda-timezone" onchange="saveTimezoneSetting(this.value)"
                                class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-sm text-zinc-200 focus:outline-none focus:border-sky-500 transition-colors">
                                <option value="America/Sao_Paulo">America/Sao_Paulo (São Paulo - Brasil)</option>
                                <option value="America/Manaus">America/Manaus (Manaus - Brasil)</option>
                                <option value="America/Noronha">America/Noronha (Fernando de Noronha - Brasil)</option>
                                <option value="America/Belem">America/Belem (Belém - Brasil)</option>
                                <option value="America/Fortaleza">America/Fortaleza (Fortaleza - Brasil)</option>
                                <option value="America/New_York">America/New_York (Nova York - EUA)</option>
                                <option value="Europe/London">Europe/London (Londres - Reino Unido)</option>
                                <option value="Europe/Paris">Europe/Paris (Paris - França)</option>
                                <option value="UTC">UTC (Tempo Universal Coordenado)</option>
                            </select>
                            <p class="text-[10px] text-zinc-500 mt-2">
                                Define as coordenadas para calcular o nascer e pôr do sol no gráfico. O padrão é America/Sao_Paulo.
                            </p>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-zinc-300 mb-2">Notificação antes do evento (horas)</label>
                            <input id="setting-agenda-notify-hours" type="number" min="1" max="720" value="24"
                                onchange="saveAgendaNotifyHours(this.value)"
                                class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-sm text-zinc-200 focus:outline-none focus:border-sky-500 transition-colors" />
                            <p class="text-[10px] text-zinc-500 mt-2">
                                Lembretes via ntfy são enviados N horas antes do evento (padrão 24h = "um dia antes"), de forma previsível.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Ntfy Tab -->
                <div x-show="$store.settings.activeTab === 'ntfy'" class="space-y-6">
                    <p class="text-sm text-zinc-400">
                        Configure as notificações de agendamentos enviadas via Ntfy (1 dia antes e resumo semanal aos domingos).
                    </p>

                    <div hx-get="/api/settings/ntfy" hx-trigger="intersect once" id="ntfy-settings-container">
                        <div class="text-center py-8">
                            <div class="animate-spin h-5 w-5 border-2 border-zinc-600 border-t-transparent rounded-full mx-auto mb-3"></div>
                            <p class="text-xs text-zinc-600">Carregando configurações Ntfy...</p>
                        </div>
                    </div>
                </div>

                <!-- Semântica Tab -->
                <div x-show="$store.settings.activeTab === 'semantica'" class="space-y-6">
                    <p class="text-sm text-zinc-400">
                        Gerencie o índice de busca semântica das suas notas.
                    </p>

                    <!-- Sensibilidade da IA -->
                    <div class="bg-zinc-800/50 rounded-xl p-4 border border-zinc-700/50">
                        <p class="text-sm text-zinc-300 font-bold mb-2">🎛️ Sensibilidade da IA</p>
                        <p class="text-xs text-zinc-500 mb-4 leading-relaxed">
                            Ajuste a porcentagem mínima de similaridade (0% a 100%) para os resultados da IA. Valores maiores tornam a busca mais rígida (menos resultados, porém mais precisos).
                        </p>
                        
                        <!-- Busca Semântica Global -->
                        <div class="mb-5">
                            <div class="flex justify-between items-center mb-1">
                                <label class="text-xs font-semibold text-zinc-300">Busca Semântica Global</label>
                                <div class="flex items-center gap-2">
                                    <span id="semantic-search-saved" class="text-[10px] text-emerald-500 font-semibold hidden">✓ Salvo</span>
                                    <span id="semantic-search-threshold-display" class="text-xs font-bold text-violet-400">50%</span>
                                </div>
                            </div>
                            <input type="range" id="semantic-search-threshold" min="10" max="100" value="50" step="1"
                                class="w-full accent-violet-500 cursor-pointer" 
                                oninput="document.getElementById('semantic-search-threshold-display').innerText = this.value + '%'"
                                onchange="saveSemanticThreshold('search', this.value)" />
                            <p class="text-[10px] text-zinc-600 mt-1 flex justify-between">
                                <span>Flexível (10%)</span>
                                <span>Rígido (100%)</span>
                            </p>
                        </div>

                        <!-- Busca Híbrida (FTS5 + IA) -->
                        <div class="mb-5">
                            <div class="flex justify-between items-center mb-1">
                                <label class="text-xs font-semibold text-zinc-300">Busca Híbrida (FTS5 + IA)</label>
                                <div class="flex items-center gap-2">
                                    <span id="semantic-hybrid-saved" class="text-[10px] text-emerald-500 font-semibold hidden">✓ Salvo</span>
                                    <span id="hybrid-threshold-display" class="text-xs font-bold text-teal-400">55%</span>
                                </div>
                            </div>
                            <input type="range" id="hybrid-threshold-slider" min="10" max="100" value="55" step="1"
                                class="w-full accent-teal-500 cursor-pointer"
                                oninput="document.getElementById('hybrid-threshold-display').innerText = this.value + '%'"
                                onchange="saveSemanticThreshold('hybrid', this.value)" />
                            <p class="text-[10px] text-zinc-600 mt-1 flex justify-between">
                                <span>Flexível (10%)</span>
                                <span>Rígido (100%)</span>
                            </p>
                            <p class="text-[10px] text-zinc-600 mt-1 leading-relaxed">
                                Limite de similaridade para o lado da IA na busca híbrida. Se não configurado, usa o valor da Busca Semântica Global.
                            </p>
                        </div>

                        <!-- Peso do rank na fusão (k do RRF) -->
                        <div class="mb-2">
                            <div class="flex justify-between items-center mb-1">
                                <label class="text-xs font-semibold text-zinc-300">Peso do rank na fusão (k do RRF)</label>
                                <div class="flex items-center gap-2">
                                    <span id="semantic-rrf-k-saved" class="text-[10px] text-emerald-500 font-semibold hidden">✓ Salvo</span>
                                    <span id="rrf-k-display" class="text-xs font-bold text-teal-400">60</span>
                                </div>
                            </div>
                            <input type="range" id="rrf-k-slider" min="10" max="100" value="60" step="1"
                                class="w-full accent-teal-500 cursor-pointer"
                                oninput="document.getElementById('rrf-k-display').innerText = this.value"
                                onchange="saveSemanticThreshold('rrf-k', this.value)" />
                            <p class="text-[10px] text-zinc-600 mt-1 leading-relaxed">
                                Menor k = a posição (rank) pesa mais na fusão texto + IA; maior k = pesa menos. Padrão 60.
                            </p>
                        </div>

                    </div>

                    <div class="bg-zinc-800/50 rounded-xl p-4 border border-zinc-700/50">
                        <p class="text-sm text-zinc-300 font-bold mb-2">🧠 Índice Semântico</p>
                        <p class="text-xs text-zinc-500 mb-4 leading-relaxed">
                            O índice semântico contém os vetores de cada nota usados para busca por similaridade (IA).
                            Se notar resultados estranhos ou inconsistentes, você pode resetar o índice e reindexar tudo do zero.
                            Isso apaga todos os dados de embeddings e chunks, e recria o índice automaticamente.
                        </p>
                        <button id="btn-reset-semantica" onclick="resetAndReindexSemantic()"
                            class="w-full py-2.5 rounded-xl bg-violet-600 hover:bg-violet-700 text-white text-sm font-bold transition-colors flex items-center justify-center gap-2">
                            Resetar Índice e Reindexar Tudo
                        </button>
                        <p id="reset-feedback" class="text-xs text-center mt-3 text-zinc-500 hidden"></p>
                    </div>
                </div>
            </div>
            </div>
        </div>
    </div>
    
    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('autoTagConfig', () => ({
                rules: [],
                saved: false,
                error: false,
                errorMsg: '',
                applying: false,
                applyMsg: '',
                init() {
                    fetch('/api/settings/auto-tag')
                        .then(r => r.json())
                        .then(data => {
                            if (Array.isArray(data)) this.rules = data;
                        })
                        .catch(e => console.error('Erro ao carregar auto-tag:', e));
                },
                saveRules() {
                    this.saved = false;
                    this.error = false;
                    fetch('/api/settings/auto-tag', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify(this.rules)
                    })
                    .then(async r => {
                        if (!r.ok) {
                            const txt = await r.text();
                            throw new Error(txt || 'Erro ao salvar');
                        }
                        this.saved = true;
                        setTimeout(() => this.saved = false, 3000);
                    })
                    .catch(e => {
                        this.error = true;
                        this.errorMsg = e.message;
                        setTimeout(() => this.error = false, 5000);
                    });
                },
                async applyTags() {
                    this.applyMsg = '';
                    this.applying = true;
                    try {
                        // Envia as regras digitadas na tela — o servidor salva e aplica.
                        // Assim o botão usa o que está visível, mesmo sem clicar em "Salvar Regras".
                        const r = await fetch('/api/settings/auto-tag/apply', {
                            method: 'POST',
                            headers: {'Content-Type': 'application/json'},
                            body: JSON.stringify(this.rules)
                        });
                        const data = await r.json().catch(() => ({}));
                        if (!r.ok) throw new Error(data.error || 'Erro ao aplicar tags');
                        this.saved = true;
                        setTimeout(() => this.saved = false, 3000);
                        this.applyMsg = data.modified > 0
                            ? '✓ ' + data.modified + (data.modified === 1 ? ' nota atualizada!' : ' notas atualizadas!')
                            : '✓ Nenhuma nota precisou de atualização.';
                        // Atualiza a sidebar com as novas tags
                        document.body.dispatchEvent(new Event('reload-sidebar'));
                    } catch (e) {
                        this.applyMsg = '✗ ' + e.message;
                    } finally {
                        this.applying = false;
                    }
                }
            }));
        });

        // Lead time de notificação da agenda (horas antes do evento)
        window.saveAgendaNotifyHours = function (hours) {
            var body = new URLSearchParams();
            body.append('hours', hours);
            fetch('/api/settings/agenda-notify', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: body.toString()
            }).then(function (r) { return r.json(); })
              .then(function (d) {
                  if (!d.ok) alert('Erro ao salvar: ' + (d.error || 'desconhecido'));
              })
              .catch(function (e) { alert('Erro ao salvar lead time: ' + e.message); });
        };

        // Carrega o valor salvo. Roda no DOMContentLoaded para garantir que o
        // fetch esteja patcheado com o header de autenticação (app.js, defer).
        document.addEventListener('DOMContentLoaded', function () {
            var input = document.getElementById('setting-agenda-notify-hours');
            if (!input) return;
            fetch('/api/settings/agenda-notify')
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (d) {
                    if (d && d.hours && !isNaN(parseInt(d.hours, 10))) {
                        input.value = parseInt(d.hours, 10);
                    }
                })
                .catch(function (e) { console.error('Erro ao carregar lead time:', e); });
        });
    </script>
}
