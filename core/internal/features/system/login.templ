package system

templ Login() {
<!doctype html>
<html lang="pt-BR" class="dark">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>Login — TON-618</title>
		<link rel="stylesheet" href="/static/fonts/fonts.css"/>
		<style>
            * { margin: 0; padding: 0; box-sizing: border-box; }
            body {
                height: 100vh; width: 100vw;
                display: flex; align-items: center; justify-content: center;
                background: #09090b; color: #f8fafc;
                font-family: "Noto Sans", system-ui, sans-serif;
            }
            .card {
                width: 100%; max-width: 380px; padding: 2.5rem;
                background: rgba(30, 41, 59, 0.4);
                backdrop-filter: blur(12px);
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 24px;
                animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1);
            }
            @keyframes slideUp {
                from { opacity: 0; transform: translateY(20px); }
                to   { opacity: 1; transform: translateY(0); }
            }
            .header { text-align: center; margin-bottom: 2rem; }
            .logo {
                width: 56px; height: 56px; margin-bottom: 1rem;
                animation: pulseGlow 3s infinite alternate;
            }
            @keyframes pulseGlow {
                from { filter: drop-shadow(0 0 5px rgba(59,130,246,0.3)); }
                to   { filter: drop-shadow(0 0 20px rgba(59,130,246,0.8)); }
            }
            h1 {
                font-size: 1.8rem; font-weight: 800; letter-spacing: -0.025em;
                background: linear-gradient(to right, #60a5fa, #3b82f6);
                -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            }
            .sub { color: #94a3b8; font-size: 0.8rem; margin-top: 0.5rem; }
            .form { display: flex; flex-direction: column; gap: 1.25rem; }
            .field { display: flex; flex-direction: column; gap: 0.4rem; }
            label { font-size: 0.8rem; font-weight: 500; color: #cbd5e1; margin-left: 0.25rem; }
            .pass-wrap { position: relative; }
            .pass-wrap input {
                width: 100%;
                background: rgba(15, 23, 42, 0.6);
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 12px;
                padding: 0.75rem 2.75rem 0.75rem 1rem;
                color: white; font-size: 0.95rem;
                transition: all 0.2s; outline: none;
            }
            .pass-wrap input:focus {
                border-color: #3b82f6;
                box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
                background: rgba(15, 23, 42, 0.8);
            }
            .toggle-pass {
                position: absolute; right: 0.75rem; top: 50%;
                transform: translateY(-50%);
                background: none; border: none; color: #64748b;
                cursor: pointer; padding: 0.25rem;
                display: flex; align-items: center;
                font-size: 1rem; transition: color 0.2s;
                line-height: 1;
            }
            .toggle-pass:hover { color: #94a3b8; }
            .remember-row {
                display: flex; align-items: center; gap: 0.5rem;
                margin-top: -0.25rem;
            }
            .remember-row input[type="checkbox"] {
                width: 1rem; height: 1rem;
                accent-color: #3b82f6; cursor: pointer;
            }
            .remember-row label {
                font-size: 0.78rem; color: #64748b;
                cursor: pointer; margin-left: 0;
            }
            .error {
                color: #f87171; font-size: 0.8rem; text-align: center;
                background: rgba(248, 113, 113, 0.1);
                padding: 0.5rem; border-radius: 8px; display: none;
            }
            .btn-submit {
                margin-top: 0.5rem; background: #3b82f6; color: white;
                border: none; border-radius: 12px; padding: 0.8rem;
                font-size: 0.95rem; font-weight: 600; cursor: pointer;
                transition: all 0.2s; width: 100%;
            }
            .btn-submit:hover {
                background: #2563eb; transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
            }
            .btn-submit:disabled {
                opacity: 0.6; cursor: not-allowed;
                transform: none; box-shadow: none;
            }
            .footer {
                margin-top: 1.5rem; text-align: center;
                border-top: 1px solid rgba(255, 255, 255, 0.05);
                padding-top: 1.2rem;
            }
            .footer p {
                font-size: 0.7rem; color: #64748b;
                letter-spacing: 0.05em; text-transform: uppercase;
            }
		</style>
	</head>
	<body>
		<div class="card">
			<div class="header">
				<svg class="logo" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
					<defs>
						<radialGradient id="g" cx="50%" cy="50%" r="50%">
							<stop offset="65%" stop-color="#000000"></stop>
							<stop offset="100%" stop-color="#0f172a"></stop>
						</radialGradient>
					</defs>
					<circle cx="50" cy="50" r="45" fill="white" opacity="0.2"></circle>
					<circle cx="50" cy="50" r="28" stroke="white" stroke-width="1.2" stroke-opacity="0.8" fill="none"></circle>
					<circle cx="50" cy="50" r="26" fill="url(#g)"></circle>
					<circle cx="50" cy="50" r="22" fill="#000"></circle>
					<path d="M50 8 C75 8 92 22 92 50 C92 68 82 82 70 86 C80 72 80 52 75 42 C70 34 58 26 50 26Z" fill="white" opacity="0.7"></path>
					<path d="M50 10 C72 10 88 25 88 50 C88 66 78 80 66 84 C76 70 76 54 72 44 C66 36 56 28 50 28Z" fill="#e2e8f0" opacity="0.3" transform="rotate(120 50 50)"></path>
					<path d="M50 10 C70 10 86 28 86 50 C86 66 78 80 66 84 C74 70 74 54 70 44 C66 36 56 28 50 28Z" fill="white" opacity="0.5" transform="rotate(240 50 50)"></path>
				</svg>
				<h1>TON-618</h1>
				<p class="sub">Buraco negro de conhecimento</p>
			</div>
			<form class="form" id="login-form">
				<div class="field">
					<label for="pass">Senha</label>
					<div class="pass-wrap">
						<input
							id="pass"
							type="password"
							placeholder="Senha de acesso"
							required
							autocomplete="current-password"
							autofocus
						/>
						<button type="button" class="toggle-pass" id="toggle-pass-btn" title="Mostrar/ocultar senha" tabindex="-1">👁</button>
					</div>
				</div>
				<div class="remember-row">
					<input type="checkbox" id="remember-me" checked/>
					<label for="remember-me">Lembrar por 30 dias</label>
				</div>
				<div class="error" id="login-error"></div>
				<button type="submit" class="btn-submit" id="login-btn">Entrar</button>
			</form>
			<div class="footer"><p>Auto-hospedado &amp; Privado</p></div>
		</div>
		<script>
            // Usuário interno fixo — login é autenticado apenas pela senha.
            // O formato "ton618:<senha>" é o token Basic Auth usado internamente.
            var _TON_USER = "ton618";

            // Flag para evitar condição de corrida entre validação automática e submit
            var _loginSubmitted = false;

            // Toggle de visibilidade da senha
            document.getElementById("toggle-pass-btn").addEventListener("click", function () {
                var passEl = document.getElementById("pass");
                if (passEl.type === "password") {
                    passEl.type = "text";
                    this.textContent = "🙈";
                } else {
                    passEl.type = "password";
                    this.textContent = "👁";
                }
            });

            // Se já tem auth em localStorage, tenta validar automaticamente
            (function () {
                var existing = localStorage.getItem("ton_auth");
                if (existing) {
                    fetch("/api/status", {
                        headers: { Authorization: existing },
                    })
                        .then(function (r) {
                            if (_loginSubmitted) return;
                            if (r.ok) {
                                var rawAuth = existing.replace("Basic ", "");
                                var maxAge = 30 * 24 * 3600;
                                document.cookie =
                                    "ton_auth=" + rawAuth +
                                    ";path=/;SameSite=Lax;max-age=" + maxAge;
                                window.location.href = "/";
                            } else {
                                localStorage.removeItem("ton_auth");
                                document.cookie = "ton_auth=;path=/;max-age=0";
                            }
                        })
                        .catch(function () {
                            if (_loginSubmitted) return;
                            localStorage.removeItem("ton_auth");
                            document.cookie = "ton_auth=;path=/;max-age=0";
                        });
                }
            })();

            document
                .getElementById("login-form")
                .addEventListener("submit", async function (e) {
                    e.preventDefault();
                    _loginSubmitted = true;
                    var pass = document.getElementById("pass").value;
                    var remember = document.getElementById("remember-me").checked;
                    var btn = document.getElementById("login-btn");
                    var errEl = document.getElementById("login-error");
                    btn.disabled = true;
                    btn.textContent = "Verificando...";
                    errEl.style.display = "none";
                    // Usa usuário interno fixo — a autenticação é feita apenas pela senha
                    var auth = btoa(_TON_USER + ":" + pass);
                    var basicHeader = "Basic " + auth;
                    try {
                        var resp = await fetch("/api/status", {
                            headers: { Authorization: basicHeader },
                        });
                        if (resp.ok) {
                            localStorage.setItem("ton_auth", basicHeader);
                            // 30 dias se "lembrar", 24 h caso contrário
                            var maxAge = remember ? (30 * 24 * 3600) : 86400;
                            document.cookie =
                                "ton_auth=" + auth +
                                ";path=/;SameSite=Lax;max-age=" + maxAge;
                            window.location.href = "/";
                        } else if (resp.status === 401) {
                            errEl.textContent = "Senha incorreta.";
                            errEl.style.display = "block";
                        } else {
                            errEl.textContent = "Erro do servidor: " + resp.status;
                            errEl.style.display = "block";
                        }
                    } catch (e) {
                        errEl.textContent = "Erro ao conectar ao servidor.";
                        errEl.style.display = "block";
                    }
                    btn.disabled = false;
                    btn.textContent = "Entrar";
                });
		</script>
	</body>
</html>
}