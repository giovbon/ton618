package search

import (
	"ton618/core/internal/ui/icons"
	"ton618/core/web/layout"
)

templ Index(title string) {
    @layout.Layout(title, false, indexContent())
}

templ indexContent() {
<div>
    <!-- Search toggle + bar -->
    <div class="flex items-center gap-3 mb-4">
        <div class="flex items-center gap-1 p-0.5 bg-zinc-950/40 border border-zinc-800/80 rounded-xl select-none">
            <!-- Busca de Notas -->
            <button
                id="btn-search-notes"
                type="button"
                onclick="setSearchMode('notes')"
                class="flex items-center justify-center p-2 rounded-lg transition-all duration-300 border bg-sky-500/20 text-sky-400 border-sky-500/40"
                title="Busca de Notas (por nome do arquivo)"
            >
                @icons.Icon(icons.GetIcon("busca-notas"), "w-4 h-4")
            </button>

            <!-- Busca Global -->
            <button
                id="btn-search-global"
                type="button"
                onclick="setSearchMode('global')"
                class="flex items-center justify-center p-2 rounded-lg transition-all duration-300 border bg-transparent text-zinc-500 border-transparent hover:text-zinc-300"
                title="Busca Global no Conteúdo (texto completo)"
            >
                @icons.Icon(icons.GetIcon("busca-global"), "w-4 h-4")
            </button>

            <!-- Perguntar às Notas (com IA) — apenas desktop -->
            <button
                id="btn-search-ask"
                type="button"
                onclick="setSearchMode('ask')"
                class="hidden md:flex items-center justify-center p-2 rounded-lg transition-all duration-300 border bg-transparent text-zinc-500 border-transparent hover:text-zinc-300"
                title="Perguntar: a IA busca nas suas notas e responde diretamente com trechos"
            >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </button>
        </div>

        <div class="relative flex-1">
            <input
                id="search-local"
                type="text"
                placeholder="Filtrar nomes das notas..."
                name="q"
                autocomplete="off"
                hx-get="/api/sidebar"
                hx-trigger="load, input changed delay:200ms, search, reload-sidebar from:body"
                hx-target="#contentArea"
                class="w-full px-4 py-2.5 text-[13px] bg-zinc-900/60 border border-sky-500/40 rounded-lg text-zinc-200 placeholder:text-zinc-500 focus:outline-hidden focus:border-sky-500 focus:ring-1 focus:ring-sky-500/40 transition-all"
            />
            <input
                id="search-global"
                type="text"
                placeholder="Buscar no conteúdo das notas (com lematização)..."
                name="q"
                autocomplete="off"
                hx-post="/search"
                hx-trigger="input changed delay:300ms, search"
                hx-target="#global-container"
                class="w-full px-4 py-2.5 text-[13px] bg-zinc-900/60 border border-emerald-500/40 rounded-lg text-zinc-200 placeholder:text-zinc-500 focus:outline-hidden focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500/40 transition-all hidden"
            />
            <!-- Input do modo Perguntar -->
            <div id="ask-input-wrap" class="hidden w-full flex-col gap-1.5">
                <div class="flex gap-2">
                    <input
                        id="search-ask"
                        type="text"
                        placeholder="Faça uma pergunta sobre suas notas..."
                        name="q"
                        autocomplete="off"
                        class="flex-1 px-4 py-2.5 text-[13px] bg-zinc-900/60 border border-amber-500/40 rounded-lg text-zinc-200 placeholder:text-zinc-500 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500/40 transition-all"
                    />
                    <button
                        id="ask-submit-btn"
                        type="button"
                        onclick="triggerAsk()"
                        class="shrink-0 px-4 py-2.5 rounded-lg bg-amber-500/20 border border-amber-500/40 text-amber-400 text-[13px] font-semibold hover:bg-amber-500/30 transition-all flex items-center gap-1.5 cursor-pointer"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                        Perguntar
                    </button>
                </div>
                <div id="ask-ollama-hint" class="hidden px-1 text-[11px] text-amber-500/70 flex items-center gap-1.5">
                    <svg class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    Configure o <button type="button" onclick="window.$store && $store.settings && $store.settings.open ? $store.settings.openTab('ollama') : null" class="underline hover:text-amber-300 cursor-pointer">Ollama em Configurações → IA</button> para obter respostas geradas por IA.
                </div>
            </div>
            <div
                id="spinner"
                class="absolute right-3 top-1/2 -translate-y-1/2 htmx-indicator"
            >
                <svg
                    class="animate-spin h-4 w-4 text-zinc-500"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                >
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>
            </div>
        </div>
    </div>

    <!-- Status do modelo semântico -->
    <div id="semantic-panel" class="hidden mb-2.5 transition-all duration-300">
        <div class="flex items-center gap-2 py-1 text-[11px] text-zinc-400">
            <!-- Indicador visual pulsante de status -->
            <div class="relative flex h-2 w-2 shrink-0">
                <span id="model-indicator-ping" class="animate-ping absolute inline-flex h-full w-full rounded-full bg-zinc-400 opacity-75"></span>
                <span id="model-indicator" class="relative inline-flex rounded-full h-2 w-2 bg-zinc-500"></span>
            </div>
            <div class="flex items-center gap-1.5 min-w-0">
                <span id="model-status-text" class="font-semibold text-zinc-300">Inicializando IA...</span>
                <span class="text-zinc-600">•</span>
                <span id="index-status-text" class="text-zinc-500">Calculando status do índice...</span>
            </div>
            <!-- Barra de download do modelo IA -->
            <div id="model-download-progress" class="hidden flex items-center gap-1.5 ml-2 shrink-0">
                <span id="model-download-text" class="text-[9px] font-mono text-zinc-500 whitespace-nowrap">0%</span>
                <div class="w-16 h-0.5 bg-zinc-800 rounded-full overflow-hidden">
                    <div id="model-download-bar" class="h-full bg-emerald-500 transition-all duration-300" style="width: 0%"></div>
                </div>
            </div>
            <!-- Progresso do download no SERVIDOR (modelo ONNX ~120MB, retomável) -->
            <span id="model-server-progress" class="hidden text-[9px] font-mono text-amber-500 whitespace-nowrap shrink-0" title="Download do modelo no servidor (feito uma única vez)"></span>
            <!-- Barra de progresso integrada -->
            <div id="reindex-progress" class="hidden flex items-center gap-1.5 ml-2 shrink-0">
                <span id="reindex-progress-text" class="text-[9px] font-mono text-zinc-500 whitespace-nowrap">0 / 0</span>
                <div class="w-10 h-0.5 bg-zinc-800 rounded-full overflow-hidden">
                    <div id="reindex-progress-bar" class="h-full bg-violet-500 transition-all duration-300" style="width: 0%"></div>
                </div>
            </div>
            <!-- Botão de Recuperação de Erro (Limpar Cache) -->
            <button id="model-reset-cache-btn" onclick="clearTransformersCache()" class="hidden ml-2 px-2 py-0.5 text-[9px] font-bold tracking-wide uppercase rounded-sm bg-red-950/40 text-red-400 border border-red-900/50 hover:bg-red-900/20 transition-all">
                Limpar Cache e Recarregar
            </button>
        </div>
    </div>

    <!-- Results -->
    <div id="results">
        <div id="compact-container">
            <div id="contentArea"></div>
        </div>
        <div id="global-container" class="hidden"></div>
        <!-- Modo Perguntar (com IA) -->
        <div id="ask-container" class="hidden">
            <div id="ask-results"></div>
        </div>
    </div>
</div>

<script>
    // Modo Perguntar (com IA) é exclusivo para desktop
    function isMobileMode() {
        return window.innerWidth < 768
            || /Android|iPhone|iPad|iPod|Mobile|webOS/i.test(navigator.userAgent)
            || (navigator.maxTouchPoints > 1 && window.innerWidth < 1024);
    }

    function syncAskButtonVisibility() {
        var btnAsk = document.getElementById("btn-search-ask");
        if (!btnAsk) return;
        if (isMobileMode()) {
            btnAsk.style.display = "none";
            if (currentSearchMode === "ask") {
                setSearchMode("notes");
            }
        } else {
            btnAsk.style.display = "";
        }
    }

    (function() {
        syncAskButtonVisibility();
        window.addEventListener("resize", syncAskButtonVisibility);

        // Pré-aquecimento em background para quem JÁ usou a IA (apenas desktop)
        document.addEventListener("DOMContentLoaded", function() {
            syncAskButtonVisibility();
            if (!isMobileMode() && localStorage.getItem("ton618_semantic_model_ready") === "1") {
                var idx = window.semanticIndex;
                if (idx && typeof idx.warmup === "function") idx.warmup();
            }
        });
    })();

    var currentSearchMode = "notes"; // "notes", "global", "ask"
    var currentSearchQuery = "";

    function setSearchMode(mode) {
        if (isMobileMode() && mode === "ask") {
            mode = "notes";
        }
        if (currentSearchMode === mode) return;
        currentSearchMode = mode;

        var btnNotes = document.getElementById("btn-search-notes");
        var btnGlobal = document.getElementById("btn-search-global");
        var btnAsk = document.getElementById("btn-search-ask");

        var localInput = document.getElementById("search-local");
        var globalInput = document.getElementById("search-global");
        var askWrap = document.getElementById("ask-input-wrap");

        var compactContainer = document.getElementById("compact-container");
        var globalContainer = document.getElementById("global-container");
        var askContainer = document.getElementById("ask-container");
        var semanticPanel = document.getElementById("semantic-panel");

        // Reset classes dos botões
        btnNotes.className = "flex items-center justify-center p-2 rounded-lg transition-all duration-300 border bg-transparent text-zinc-500 border-transparent hover:text-zinc-300";
        btnGlobal.className = "flex items-center justify-center p-2 rounded-lg transition-all duration-300 border bg-transparent text-zinc-500 border-transparent hover:text-zinc-300";
        btnAsk.className = "hidden md:flex items-center justify-center p-2 rounded-lg transition-all duration-300 border bg-transparent text-zinc-500 border-transparent hover:text-zinc-300";

        localInput.classList.add("hidden");
        globalInput.classList.add("hidden");
        if (askWrap) askWrap.classList.add("hidden");

        compactContainer.classList.add("hidden");
        globalContainer.classList.add("hidden");
        if (askContainer) askContainer.classList.add("hidden");
        if (semanticPanel) semanticPanel.classList.add("hidden");

        if (mode === "notes") {
            btnNotes.className = "flex items-center justify-center p-2 rounded-lg transition-all duration-300 border bg-sky-500/20 text-sky-400 border-sky-500/40";
            localInput.classList.remove("hidden");
            compactContainer.classList.remove("hidden");
            localInput.focus();
        } else if (mode === "global") {
            btnGlobal.className = "flex items-center justify-center p-2 rounded-lg transition-all duration-300 border bg-emerald-500/20 text-emerald-400 border-emerald-500/40";
            globalInput.classList.remove("hidden");
            globalContainer.classList.remove("hidden");
            globalInput.focus();
        } else if (mode === "ask") {
            btnAsk.className = "hidden md:flex items-center justify-center p-2 rounded-lg transition-all duration-300 border bg-amber-500/20 text-amber-400 border-amber-500/40";
            if (askWrap) askWrap.classList.remove("hidden");
            if (askContainer) askContainer.classList.remove("hidden");
            if (semanticPanel) semanticPanel.classList.remove("hidden");
            var askInput = document.getElementById("search-ask");
            if (askInput) askInput.focus();

            initSemanticUI();
            loadIndexStatus();
            updateOllamaHint();
        }
    }

    // Inicializa a UI com o singleton compartilhado (sem criar worker próprio)
    function initSemanticUI() {
        var idx = window.semanticIndex;
        if (!idx) return;

        updateStatus("loading", "Inicializando IA...", "Calculando status do índice...");

        // Timeout de 60s: se o modelo não carregar, mostra dica de troubleshooting
        var loadTimeout = setTimeout(function() {
            if (!idx.isReady) {
                updateStatus("error", "Erro ao carregar modelo", "O modelo demorou muito.");
                var progressEl = document.getElementById("model-download-progress");
                if (progressEl) progressEl.classList.add("hidden");
            }
        }, 60000);

        // Registra callbacks de progresso e prontidão
        idx.onProgress(function(msg) {
            var pct = msg.total > 0 ? Math.round((msg.loaded / msg.total) * 100) : 0;
            updateStatus("loading", "Baixando modelo: " + pct + "%");
            
            var progressEl = document.getElementById("model-download-progress");
            if (progressEl) {
                progressEl.classList.remove("hidden");
                var textEl = document.getElementById("model-download-text");
                var barEl = document.getElementById("model-download-bar");
                if (textEl) textEl.textContent = pct + "%";
                if (barEl) barEl.style.width = pct + "%";
            }
        });

        idx.onError(function(msg) {
            clearTimeout(loadTimeout);
            updateStatus("error", "Erro: " + msg);
            var progressEl = document.getElementById("model-download-progress");
            if (progressEl) progressEl.classList.add("hidden");
        });

        idx.onReady(function() {
            clearTimeout(loadTimeout);
            updateStatus(null, "Modelo pronto");
            
            var progressEl = document.getElementById("model-download-progress");
            if (progressEl) progressEl.classList.add("hidden");

            loadIndexStatus();

            // Se já tinha texto digitado, dispara o input para executar a busca
            var pendingQuery = document.getElementById("search-semantic").value.trim();
            if (pendingQuery) {
                var evt = new Event("input", { bubbles: true });
                document.getElementById("search-semantic").dispatchEvent(evt);
            }
        });

        // Warm-up: pré-carrega o modelo (se já estiver pronto, onReady dispara imediatamente)
        idx.warmup();
        // Progresso do download feito pelo SERVIDOR (uma única vez, no boot).
        pollModelServer();
    }

    // pollModelServer mostra o andamento do download do modelo ONNX no servidor
    // (arquivo atual + percentual). O modelo é baixado no boot para o volume
    // persistente e servido em /models/*; o download é retomável (HTTP Range) e
    // o .part preservado, então este painel também serve para ver a retomada.
    var serverPoll = false;
    function pollModelServer() {
        if (serverPoll) return;
        serverPoll = true;
        var tick = function () {
            var el = document.getElementById("model-server-progress");
            if (!el) { serverPoll = false; return; }
            fetch("/api/embeddings/model-status")
                .then(function (r) { return r.json(); })
                .then(function (p) {
                    if (!p || p.ready) {
                        el.classList.add("hidden");
                        serverPoll = false;
                        return;
                    }
                    var pct = typeof p.percent === "number" ? p.percent : 0;
                    var nome = String(p.file || "").split("/").pop();
                    var txt = "Servidor " + pct + "%";
                    if (nome) txt += " (" + nome + ")";
                    if (p.last_error) txt += " · erro: " + p.last_error;
                    el.textContent = txt;
                    el.classList.remove("hidden");
                    setTimeout(tick, 2000);
                })
                .catch(function () {
                    el.classList.add("hidden");
                    serverPoll = false;
                });
        };
        tick();
    }

    function updateStatus(state, modelText, indexText) {
        if (state) {
            var indicator = document.getElementById("model-indicator");
            var ping = document.getElementById("model-indicator-ping");
            var resetBtn = document.getElementById("model-reset-cache-btn");
            if (indicator && ping) {
                if (state === "ready") {
                    indicator.className = "relative inline-flex rounded-full h-2 w-2 bg-emerald-500";
                    ping.className = "animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-20";
                    if (resetBtn) resetBtn.classList.add("hidden");
                } else if (state === "error") {
                    indicator.className = "relative inline-flex rounded-full h-2 w-2 bg-red-500";
                    ping.className = "absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-0";
                    if (resetBtn) resetBtn.classList.remove("hidden");
                } else { // "loading" or "indexing"
                    indicator.className = "relative inline-flex rounded-full h-2 w-2 bg-amber-500";
                    ping.className = "animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75";
                    if (resetBtn) resetBtn.classList.add("hidden");
                }
            }
        }
        if (modelText !== undefined && modelText !== null) {
            var statusText = document.getElementById("model-status-text");
            if (statusText) statusText.textContent = modelText;
        }
        if (indexText !== undefined && indexText !== null) {
            var indexTextEl = document.getElementById("index-status-text");
            if (indexTextEl) indexTextEl.textContent = indexText;
        }
    }

    function clearTransformersCache() {
        var btn = document.getElementById("model-reset-cache-btn");
        if (btn) {
            btn.disabled = true;
            btn.textContent = "Limpando...";
        }
        if ('caches' in window) {
            caches.keys().then(function(names) {
                var promises = names.filter(function(name) {
                    return name.includes('transformers') || name.includes('onnx');
                }).map(function(name) {
                    return caches.delete(name);
                });
                return Promise.all(promises);
            }).then(function() {
                console.log("[SemanticSearch] Cache de IA limpo.");
                window.location.reload();
            }).catch(function(err) {
                console.error("[SemanticSearch] Erro ao limpar cache:", err);
                window.location.reload();
            });
        } else {
            window.location.reload();
        }
    }

    function loadIndexStatus() {
        var idx = window.semanticIndex;
        var idxReady = idx && idx.isReady;

        updateStatus(idxReady ? null : "loading", null, "Calculando status do índice...");
        fetch("/api/embeddings/status")
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.pending_notes > 0 || data.stale_notes > 0) {
                    var msg = data.indexed_notes + "/" + data.total_notes + " indexadas";
                    if (data.stale_notes > 0) msg += ", " + data.stale_notes + " desatualizadas";
                    msg += " — indexando pendentes...";
                    updateStatus("indexing", null, msg);
                    
                    var progressEl = document.getElementById("reindex-progress");
                    if (progressEl) progressEl.classList.remove("hidden");
                    updateReindexProgress(0, data.pending_notes);

                    if (idx) {
                        idx.indexPending(function(indexed, total) {
                            updateReindexProgress(indexed, total);
                        }).catch(function(e) {
                            console.error("Erro na indexação automática:", e);
                            updateStatus("error", null, "Erro na indexação");
                        }).finally(function() {
                            var progressEl = document.getElementById("reindex-progress");
                            if (progressEl) progressEl.classList.add("hidden");
                            refreshStatusOnly();
                        });
                    } else {
                        updateStatus("error", null, "Erro: semanticIndex não carregado");
                        console.error("[SemanticSearch] window.semanticIndex is undefined");
                    }
                } else if (data.total_notes > 0) {
                    var msg = "Todas " + data.total_notes + " notas indexadas";
                    if (data.stale_notes > 0) {
                        msg = data.indexed_notes + "/" + data.total_notes + " indexadas, " + data.stale_notes + " desatualizadas";
                        updateStatus("indexing", null, msg);
                    } else {
                        updateStatus(idxReady ? "ready" : "loading", null, msg);
                    }
                    var progressEl = document.getElementById("reindex-progress");
                    if (progressEl) progressEl.classList.add("hidden");
                } else {
                    updateStatus(idxReady ? "ready" : "loading", null, "Nenhuma nota encontrada");
                    var progressEl = document.getElementById("reindex-progress");
                    if (progressEl) progressEl.classList.add("hidden");
                }
            })
            .catch(function(err) {
                console.error("[SemanticSearch] loadIndexStatus error:", err);
                updateStatus("error", null, "Erro ao conectar: " + err.message);
            });
    }

    function updateReindexProgress(indexed, total) {
        var pct = total > 0 ? Math.round((indexed / total) * 100) : 0;
        document.getElementById("reindex-progress-text").textContent = indexed + " / " + total;
        document.getElementById("reindex-progress-bar").style.width = pct + "%";
    }

    function editorRouteForTipo(tipo) {
        switch (tipo) {
            case "desenho":    return "/drawing";
            case "markmap":    return "/mindmap";
            case "mindmap":    return "/mindmap";
            default:           return "/editor";
        }
    }

    function escapeHtml(str) {
        return str.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
    }

    function refreshStatusOnly() {
        fetch("/api/embeddings/status")
            .then(function(r) { return r.json(); })
            .then(function(data) {
                var idx = window.semanticIndex;
                var idxReady = idx && idx.isReady;
                
                if (data.pending_notes === 0 && data.stale_notes === 0) {
                    updateStatus(idxReady ? "ready" : "loading", null, "Todas " + data.total_notes + " notas indexadas");
                    var progressEl = document.getElementById("reindex-progress");
                    if (progressEl) progressEl.classList.add("hidden");
                } else if (data.total_notes > 0) {
                    updateStatus("indexing", null, data.indexed_notes + "/" + data.total_notes + " indexadas, " + (data.pending_notes + data.stale_notes) + " restantes");
                } else {
                    updateStatus(idxReady ? "ready" : "loading", null, "Nenhuma nota encontrada");
                }
            }).catch(function(err) {
                console.error("[SemanticSearch] refreshStatus error:", err);
            });
    }

    // Helper to generate regex pattern for accent-insensitive search
    function makeAccentInsensitivePattern(str) {
        var charMap = {
            'a': '[aáàâãäAÁÀÂÃÄ]', 'á': '[aáàâãäAÁÀÂÃÄ]', 'à': '[aáàâãäAÁÀÂÃÄ]', 'â': '[aáàâãäAÁÀÂÃÄ]', 'ã': '[aáàâãäAÁÀÂÃÄ]', 'ä': '[aáàâãäAÁÀÂÃÄ]',
            'e': '[eéèêëEÉÈÊË]', 'é': '[eéèêëEÉÈÊË]', 'è': '[eéèêëEÉÈÊË]', 'ê': '[eéèêëEÉÈÊË]', 'ë': '[eéèêëEÉÈÊË]',
            'i': '[iíìîïIÍÌÎÏ]', 'í': '[iíìîïIÍÌÎÏ]', 'ì': '[iíìîïIÍÌÎÏ]', 'î': '[iíìîïIÍÌÎÏ]', 'ï': '[iíìîïIÍÌÎÏ]',
            'o': '[oóòôõöOÓÒÔÕÖ]', 'ó': '[oóòôõöOÓÒÔÕÖ]', 'ò': '[oóòôõöOÓÒÔÕÖ]', 'ô': '[oóòôõöOÓÒÔÕÖ]', 'õ': '[oóòôõöOÓÒÔÕÖ]', 'ö': '[oóòôõöOÓÒÔÕÖ]',
            'u': '[uúùûüUÚÙÛÜ]', 'ú': '[uúùûüUÚÙÛÜ]', 'ù': '[uúùûüUÚÙÛÜ]', 'û': '[uúùûüUÚÙÛÜ]', 'ü': '[uúùûüUÚÙÛÜ]',
            'c': '[cçCÇ]', 'ç': '[cçCÇ]'
        };
        var pattern = "";
        for (var i = 0; i < str.length; i++) {
            var ch = str[i].toLowerCase();
            if (charMap[ch]) {
                pattern += charMap[ch];
            } else {
                pattern += str[i].replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
            }
        }
        return pattern;
    }

    function cleanJSOperators(w) {
        if (!w) return "";
        w = w.replace(/^[+\-~#]+/, "");
        w = w.replace(/[*~]+$/, "");
        w = w.replace(/^["']+|["']+$/g, "");
        return w.trim();
    }

    // ── Original FTS5 search highlight ──
    function highlightSearchTerms(query) {
        if (!query) return;

        var rawTerms = [];
        var remaining = query;
        var quoteRe = /"([^"]*)"|\'([^']*)'/g;
        var m;
        while ((m = quoteRe.exec(query)) !== null) {
            var phrase = m[1] || m[2];
            if (phrase && phrase.length > 1) {
                rawTerms.push(phrase);
            }
            remaining = remaining.replace(m[0], " ");
        }
        var words = remaining.split(/\s+/).filter(function (w) {
            return w.length > 1 && w !== '"' && !w.startsWith('-') && !w.startsWith('+tags:') && !w.startsWith('#');
        });
        rawTerms = rawTerms.concat(words);

        var terms = [];
        var seen = {};
        rawTerms.forEach(function(w) {
            var cleaned = cleanJSOperators(w);
            if (cleaned.length > 1 && !seen[cleaned.toLowerCase()]) {
                seen[cleaned.toLowerCase()] = true;
                terms.push(cleaned);
            }
        });

        if (!terms.length) return;

        var stemsEl = document.getElementById("search-metadata");
        var stems = [];
        if (stemsEl && stemsEl.dataset.stems) {
            stems = stemsEl.dataset.stems.split(",").filter(function(s) { return s.length > 0; });
        }

        document.querySelectorAll("#global-container a, #hybrid-container a, .search-section-title, .search-tag-item").forEach(function (el) {
            var html = el.innerHTML;
            terms.forEach(function (w) {
                var pat = makeAccentInsensitivePattern(w);
                var re = new RegExp("(" + pat + ")(?![^<]*>|[^<>]*<\/)", "gi");
                html = html.replace(re, '<span class="search-highlight text-sky-400 font-bold bg-sky-500/10 rounded-sm px-0.5">$1</span>');
            });
            stems.forEach(function (stem) {
                var cleanedStem = cleanJSOperators(stem);
                if (cleanedStem.length <= 1) return;
                var pat = makeAccentInsensitivePattern(cleanedStem);
                var re = new RegExp("\\b(" + pat + "[a-zA-Z0-9À-ÿ_]*)\\b(?![^<]*>|[^<>]*<\/)", "gi");
                html = html.replace(re, function(match, group1, offset, fullText) {
                    var prevText = fullText.slice(0, offset);
                    var lastSpanIdx = prevText.lastIndexOf("<span");
                    if (lastSpanIdx !== -1) {
                        var lastCloseIdx = prevText.lastIndexOf("</span>");
                        if (lastCloseIdx < lastSpanIdx) {
                            var spanOpenTag = prevText.slice(lastSpanIdx);
                            if (spanOpenTag.includes("search-highlight")) {
                                return match;
                            }
                        }
                    }
                    return '<span class="stem-highlight text-violet-400 font-bold bg-violet-500/15 rounded-sm px-0.5">' + match + '</span>';
                });
            });
            el.innerHTML = html;
        });
    }

    document.body.addEventListener('htmx:afterSwap', function(evt) {
        if (evt.detail.target.id === 'global-container') {
            var q = document.getElementById('search-global').value;
            highlightSearchTerms(q);
        }
    });

    // ── Modo Perguntar & Síntese RAG via Ollama ──
    var askSearchTimeout = null;
    var currentAskData = null;
    var currentAskQuery = "";
    var _ollamaConfigured = null; // null=unknown, true/false
    var _currentSynthAbort = null;

    // Verifica se Ollama está configurado (cache de sessão)
    function checkOllamaConfigured(cb) {
        if (_ollamaConfigured !== null) { cb(_ollamaConfigured); return; }
        fetch("/api/settings/ollama")
            .then(function(r) { return r.ok ? r.json() : null; })
            .then(function(d) {
                _ollamaConfigured = !!(d && d.url && d.url !== "" && d.model && d.model !== "");
                cb(_ollamaConfigured);
            })
            .catch(function() { _ollamaConfigured = false; cb(false); });
    }

    // Atualiza dica de Ollama na UI baseado na configuração
    function updateOllamaHint() {
        checkOllamaConfigured(function(configured) {
            var hint = document.getElementById("ask-ollama-hint");
            if (hint) hint.classList.toggle("hidden", configured);
        });
    }

    // Escuta evento emitido quando o usuário salva configuração Ollama
    document.addEventListener("ollama-configured", function(e) {
        _ollamaConfigured = true;
        updateOllamaHint();
    });

    document.getElementById("search-ask").addEventListener("keydown", function(e) {
        if (e.key === "Enter") { e.preventDefault(); triggerAsk(); }
    });

    document.getElementById("search-ask").addEventListener("input", function() {
        clearTimeout(askSearchTimeout);
        askSearchTimeout = setTimeout(function() {
            // Pequeno debounce se preferir digitar
        }, 1200);
    });

    function triggerAsk() {
        if (isMobileMode()) return;
        var query = (document.getElementById("search-ask").value || "").trim();
        if (!query) return;
        runAsk(query);
    }

    function runAsk(query) {
        currentAskQuery = query;
        var resultsEl = document.getElementById("ask-results");
        resultsEl.innerHTML = '<div class="flex items-center gap-2 py-8 justify-center text-zinc-500 text-sm animate-pulse">' +
            '<svg class="w-4 h-4 animate-spin text-amber-500" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>' +
            'Buscando nas suas notas...</div>';

        var btn = document.getElementById("ask-submit-btn");
        if (btn) { btn.disabled = true; btn.classList.add("opacity-50"); }

        var idx = window.semanticIndex;
        var embeddingPromise = (idx && idx.isReady)
            ? idx.embed(query)
            : Promise.resolve([]);

        embeddingPromise.then(function(embedding) {
            return fetch("/api/ask", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ query: query, embedding: embedding || [], limit: 5 })
            });
        }).then(function(r) {
            if (!r.ok) throw new Error("HTTP " + r.status);
            return r.json();
        }).then(function(data) {
            currentAskData = data;
            renderAskResults(data, query);
        }).catch(function(err) {
            resultsEl.innerHTML = '<p class="text-red-400 text-sm text-center py-8">Erro: ' + escapeHtml(err.message) + '</p>';
        }).finally(function() {
            if (btn) { btn.disabled = false; btn.classList.remove("opacity-50"); }
        });
    }

    // Extrai palavras-chave da query para highlighting nos trechos
    function extractKeywordsForHighlight(query) {
        var clean = (query || "").toLowerCase()
            .replace(/[^\w\sáàâãéèêíïóôõöúçñ-]/gi, ' ');
        var stopwords = {
            "qual": true, "quais": true, "como": true, "onde": true, "quando": true, "quem": true,
            "porque": true, "para": true, "com": true, "sem": true, "criar": true, "fazer": true,
            "usar": true, "de": true, "do": true, "da": true, "dos": true, "das": true, "em": true,
            "no": true, "na": true, "um": true, "uma": true, "que": true, "what": true, "how": true
        };
        return clean.split(/\s+/).filter(function(w) {
            return w.length > 2 && !stopwords[w];
        });
    }

    // Formata markdown de forma segura e grifa termos
    function formatMarkdownRich(text, keywordsToHighlight) {
        if (!text) return "";
        var s = escapeHtml(text);

        // Blocos de código multilinhas ```
        s = s.replace(/```([a-zA-Z0-9_-]*)\n([\s\S]*?)```/g, function(match, lang, code) {
            return '<pre class="my-2 p-3 bg-zinc-950/80 border border-zinc-800 rounded-lg text-xs font-mono text-amber-200 overflow-x-auto select-all"><code>' + code.trim() + '</code></pre>';
        });

        // Código inline `código`
        s = s.replace(/`([^`]+)`/g, '<code class="px-1.5 py-0.5 bg-zinc-800/80 border border-zinc-700/50 rounded text-[11px] font-mono text-amber-300">$1</code>');

        // Negrito **texto**
        s = s.replace(/\*\*([^*]+)\*\*/g, '<strong class="text-zinc-100 font-semibold">$1</strong>');

        // Itálico *texto*
        s = s.replace(/\*([^*]+)\*/g, '<em class="text-zinc-300 italic">$1</em>');

        // Listas com marcadores
        s = s.replace(/(?:^|\n)[-*]\s+([^\n]+)/g, '<li class="ml-4 list-disc text-zinc-300 my-0.5">$1</li>');

        // Quebras de parágrafo
        s = s.replace(/\n\n+/g, '</p><p class="mt-2 leading-relaxed">');
        s = s.replace(/\n/g, '<br>');
        s = '<p class="leading-relaxed">' + s + '</p>';
        s = s.replace(/<p class="leading-relaxed"><\/p>/g, '');

        // Destaque visual dos termos da pergunta fora de tags HTML
        if (keywordsToHighlight && keywordsToHighlight.length > 0) {
            keywordsToHighlight.forEach(function(kw) {
                if (kw.length <= 1) return;
                var cleanKw = cleanJSOperators(kw);
                var pat = makeAccentInsensitivePattern(cleanKw);
                var re = new RegExp("\\b(" + pat + "[a-zA-Z0-9À-ÿ_]*)\\b(?![^<]*>|[^<>]*<\/)", "gi");
                s = s.replace(re, function(m) {
                    return '<mark class="bg-amber-500/20 text-amber-300 font-medium rounded-xs px-0.5 border border-amber-500/30">' + m + '</mark>';
                });
            });
        }
        return s;
    }

    function renderAskResults(data, query) {
        var el = document.getElementById("ask-results");
        var sources = data.sources || [];

        if (!data.found || !sources.length) {
            el.innerHTML =
                '<div class="text-center py-16">' +
                '<div class="text-4xl mb-4 opacity-30">🔍</div>' +
                '<p class="text-zinc-400 text-sm font-medium">Não encontrei essa informação nas suas notas.</p>' +
                '<p class="text-zinc-600 text-xs mt-1">Tente reformular a pergunta ou verificar se a nota existe.</p>' +
                '</div>';
            return;
        }

        var keywords = extractKeywordsForHighlight(query);
        var html = '';

        // Cabeçalho da resposta
        html += '<div class="mb-5 pb-4 border-b border-zinc-800/60 flex flex-wrap items-center justify-between gap-3">' +
            '<div>' +
            '<div class="flex items-center gap-2 mb-1">' +
            '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>' +
            '<span class="text-[11px] font-semibold text-amber-400 tracking-wide uppercase">Encontrei nas suas notas</span>' +
            '<span class="text-[10px] text-zinc-500">(' + sources.length + ' fonte' + (sources.length === 1 ? '' : 's') + ')</span>' +
            '</div>' +
            '<p class="text-[12px] text-zinc-400 italic">&ldquo;' + escapeHtml(query) + '&rdquo;</p>' +
            '</div>' +
            '<div id="ask-header-actions">' +
            '<button id="ask-synth-btn" type="button" onclick="startSynthesizer(currentAskQuery, currentAskData ? currentAskData.sources : [])" class="hidden px-2.5 py-1.5 rounded-lg bg-amber-500/15 border border-amber-500/30 text-amber-300 hover:bg-amber-500/25 text-[11px] font-medium flex items-center gap-1.5 transition-all shadow-xs">' +
            '<svg class="w-3.5 h-3.5 text-amber-400" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.2h7.6l-6.1 4.5 2.3 7.3-6.2-4.6-6.2 4.6 2.3-7.3-6.1-4.5h7.6z"/></svg>' +
            'Sintetizar com Ollama' +
            '</button>' +
            '</div>' +
            '</div>';

        // Slot para o Card de Síntese (Ollama)
        html += '<div id="ask-synth-slot" class="mb-6"></div>';

        // Cards das fontes
        html += '<div class="space-y-4">';
        sources.forEach(function(src, idx) {
            var route = editorRouteForTipo(src.type || "");
            var fileUrl = route + '?file=' + encodeURIComponent(src.filename || "");

            var excerptHtml = formatMarkdownRich(src.excerpt || "", keywords);

            // Badges
            var badges = '';
            if (src.is_sem && src.sem_sim > 0) {
                var simPct = Math.round(src.sem_sim * 100);
                var simColor = simPct > 75 ? 'text-teal-400' : simPct > 50 ? 'text-yellow-400' : 'text-zinc-400';
                badges += '<span class="px-1.5 py-0.5 rounded-sm bg-teal-950/40 border border-teal-500/20 text-[9px] font-black tracking-widest uppercase ' + simColor + '">' + simPct + '% IA</span>';
            }
            if (src.is_fts) {
                badges += '<span class="px-1.5 py-0.5 rounded-sm bg-sky-950/40 border border-sky-500/20 text-[9px] font-black tracking-widest uppercase text-sky-400">texto</span>';
            }

            html +=
                '<div class="relative bg-zinc-900/40 border border-zinc-800/50 hover:border-amber-500/30 rounded-xl p-4 transition-all duration-300 group">' +
                // Número de ordem
                '<div class="absolute -top-2.5 -left-2 w-5 h-5 rounded-full bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-[10px] font-black text-amber-400">' + (idx + 1) + '</div>' +
                // Header da nota
                '<div class="flex items-center gap-2 mb-3">' +
                '<a href="' + fileUrl + '" class="text-[13px] font-black text-sky-400 hover:text-sky-300 truncate transition-colors flex-1 min-w-0">' +
                escapeHtml(src.name || src.filename) +
                '</a>' +
                '<div class="flex items-center gap-1 shrink-0">' + badges + '</div>' +
                '</div>' +
                // Trecho extraído formatado
                '<div class="text-[13px] leading-relaxed text-zinc-300 font-sans border-l-2 border-amber-500/30 pl-3">' +
                excerptHtml +
                '</div>' +
                // Link para abrir a nota
                '<div class="mt-3 flex justify-end">' +
                '<a href="' + fileUrl + '" class="flex items-center gap-1 text-[10px] text-zinc-600 hover:text-amber-400 transition-colors">' +
                '<svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>' +
                'Abrir nota' +
                '</a>' +
                '</div>' +
                '</div>';
        });
        html += '</div>';

        // Nota de rodapé
        html += '<p class="text-[10px] text-zinc-700 text-center mt-6 pb-2">Resposta gerada a partir do conteúdo das suas notas · nenhum dado externo foi usado</p>';

        el.innerHTML = html;

        // Mostra o botão "Sintetizar" apenas se Ollama estiver configurado
        checkOllamaConfigured(function(configured) {
            var btn = document.getElementById("ask-synth-btn");
            if (btn) btn.classList.toggle("hidden", !configured);
        });
    }

    // ── Síntese via Ollama (SSE streaming) ──
    function startSynthesizer(query, sources) {
        var slot = document.getElementById("ask-synth-slot");
        if (!slot || !sources || !sources.length) return;

        // Cancela síntese anterior se ainda estiver em andamento
        if (_currentSynthAbort) { _currentSynthAbort(); _currentSynthAbort = null; }

        // Monta o card de síntese
        slot.innerHTML =
            '<div id="ask-synth-card" class="relative bg-gradient-to-b from-amber-950/20 to-zinc-900/60 border border-amber-500/40 rounded-xl p-5 shadow-lg shadow-amber-500/5">' +
            '<div class="flex items-center justify-between mb-3 pb-2.5 border-b border-amber-500/20">' +
            '<div class="flex items-center gap-2">' +
            '<svg class="w-4 h-4 text-amber-400 animate-pulse" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.2h7.6l-6.1 4.5 2.3 7.3-6.2-4.6-6.2 4.6 2.3-7.3-6.1-4.5h7.6z"/></svg>' +
            '<span id="ask-synth-title" class="text-[12px] font-bold text-amber-300 tracking-wide uppercase">Resposta IA</span>' +
            '</div>' +
            '<div class="flex items-center gap-2">' +
            '<span id="synth-status-badge" class="px-2 py-0.5 rounded-full bg-amber-500/20 border border-amber-500/30 text-[10px] font-semibold text-amber-300 flex items-center gap-1.5">' +
            '<span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span> Gerando...' +
            '</span>' +
            '<button id="synth-copy-btn" type="button" onclick="copySynthText()" class="hidden px-2 py-0.5 text-[10px] font-medium text-zinc-400 hover:text-amber-300 hover:bg-zinc-800/80 rounded transition-all">Copiar</button>' +
            '</div>' +
            '</div>' +
            '<div id="synth-content" class="text-[13.5px] leading-relaxed text-zinc-200 font-sans min-h-[48px]">' +
            '<span class="inline-block w-1.5 h-3.5 bg-amber-400 animate-pulse"></span>' +
            '</div>' +
            '</div>';

        var synthContentEl = document.getElementById("synth-content");
        var statusBadge = document.getElementById("synth-status-badge");
        var copyBtn = document.getElementById("synth-copy-btn");
        var accumulated = "";
        var done = false;
        window.currentSynthesizedText = "";

        var authHeaders = { "Content-Type": "application/json" };
        if (window.getAuthHeader) Object.assign(authHeaders, window.getAuthHeader());

        fetch("/api/ask/synthesize", {
            method: "POST",
            headers: authHeaders,
            body: JSON.stringify({ query: query, sources: sources })
        }).then(function(r) {
            if (!r.ok) {
                return r.text().then(function(t) { throw new Error(t || "HTTP " + r.status); });
            }
            var reader = r.body.getReader();
            var decoder = new TextDecoder();
            var buffer = "";
            // Nome do último `event:` lido — os frames de controle (meta/error) usam
            // o mesmo campo `data:` dos tokens.
            var pendingEvent = "";

            _currentSynthAbort = function() {
                done = true;
                try { reader.cancel(); } catch(e) {}
            };

            function pump() {
                if (done) return;
                reader.read().then(function(result) {
                    if (result.done || done) {
                        if (!done) {
                            done = true;
                            window.currentSynthesizedText = accumulated;
                            if (synthContentEl) synthContentEl.innerHTML = formatMarkdownRich(accumulated, []);
                            if (statusBadge) {
                                statusBadge.innerHTML = '✨ Concluído';
                                statusBadge.className = "px-2 py-0.5 rounded-full bg-amber-500/20 border border-amber-500/30 text-[10px] font-semibold text-amber-300";
                            }
                            if (copyBtn) copyBtn.classList.remove("hidden");
                        }
                        return;
                    }
                    buffer += decoder.decode(result.value, { stream: true });
                    var lines = buffer.split("\n");
                    buffer = lines.pop();
                    lines.forEach(function(line) {
                        if (line.startsWith("event: ")) {
                            pendingEvent = line.slice(7).trim();
                            return;
                        }
                        if (!line.startsWith("data: ")) return;

                        var raw = line.slice(6).trim();
                        var payload = null;
                        if (raw && raw !== "{}") {
                            try { payload = JSON.parse(raw); } catch (e) {}
                        }

                        // Metadados: mostra qual backend/modelo respondeu.
                        if (pendingEvent === "meta") {
                            var titleEl = document.getElementById("ask-synth-title");
                            if (titleEl && payload) {
                                titleEl.textContent = "Resposta IA · " + (payload.provider || "local") +
                                    (payload.model ? " (" + payload.model + ")" : "");
                            }
                            pendingEvent = "";
                            return;
                        }

                        // Falha do modelo (nome errado, falta de memória, conexão).
                        if (pendingEvent === "error") {
                            done = true;
                            var msg = (payload && payload.message) ? String(payload.message) : "falha na IA local";
                            if (synthContentEl) {
                                synthContentEl.innerHTML =
                                    '<div class="text-xs text-red-400 bg-red-950/20 border border-red-900/40 rounded-lg p-2.5">' +
                                    escapeHtml(msg) +
                                    '<br><span class="text-zinc-500 mt-1 inline-block">Confira a URL e o modelo em Configurações → IA.</span></div>';
                            }
                            if (statusBadge) {
                                statusBadge.innerHTML = 'Falha';
                                statusBadge.className = "px-2 py-0.5 rounded-full bg-red-500/20 border border-red-500/30 text-[10px] font-semibold text-red-300";
                            }
                            pendingEvent = "";
                            return;
                        }

                        pendingEvent = "";
                        if (typeof payload === "string") {
                            accumulated += payload;
                            window.currentSynthesizedText = accumulated;
                            if (synthContentEl) {
                                synthContentEl.innerHTML = formatMarkdownRich(accumulated, []) +
                                    '<span class="inline-block w-1.5 h-3.5 bg-amber-400 ml-1 translate-y-0.5 animate-pulse"></span>';
                            }
                            if (statusBadge && statusBadge.querySelector('.animate-ping')) {
                                statusBadge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Gerando...';
                                statusBadge.className = "px-2 py-0.5 rounded-full bg-emerald-500/20 border border-emerald-500/30 text-[10px] font-semibold text-emerald-300 flex items-center gap-1.5";
                            }
                        }
                    });
                    pump();
                }).catch(function(e) {
                    if (!done) {
                        if (synthContentEl) synthContentEl.innerHTML += '<span class="text-red-400 text-xs block mt-2">Conexão interrompida.</span>';
                    }
                });
            }
            pump();
        }).catch(function(err) {
            if (synthContentEl) {
                synthContentEl.innerHTML =
                    '<div class="text-xs text-red-400 bg-red-950/20 border border-red-900/40 rounded-lg p-2.5">' +
                    escapeHtml(err.message || "Erro desconhecido") +
                    '<br><span class="text-zinc-500 mt-1 inline-block">Verifique se o Ollama está rodando e configurado em Configurações → IA.</span>' +
                    '</div>';
            }
            if (statusBadge) {
                statusBadge.innerHTML = 'Falha';
                statusBadge.className = "px-2 py-0.5 rounded-full bg-red-500/20 border border-red-500/30 text-[10px] font-semibold text-red-300";
            }
        });
    }

    function copySynthText() {
        var text = window.currentSynthesizedText || "";
        if (!text) return;
        navigator.clipboard.writeText(text).then(function() {
            var btn = document.getElementById("synth-copy-btn");
            if (btn) {
                var prev = btn.textContent;
                btn.textContent = "Copiado!";
                btn.classList.add("text-emerald-400");
                setTimeout(function() { btn.textContent = prev; btn.classList.remove("text-emerald-400"); }, 2000);
            }
        });
    }
</script>
}
