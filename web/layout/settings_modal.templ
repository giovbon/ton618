package layout

import "ton618/core/internal/ui/icons"
import "ton618/core/internal/core/featureflags"

templ SettingsModal() {
    {{
        flags := featureflags.FromContext(ctx)
    }}
    <!-- Settings Modal -->
    <div id="settings-modal" x-data x-show="$store.settings.open" x-cloak
        class="fixed inset-0 z-[100] flex items-center justify-center bg-black/70 backdrop-blur-xs">
        <div
            class="bg-zinc-900 border border-zinc-800 rounded-2xl shadow-2xl w-full max-w-xl md:max-w-3xl mx-4 max-h-[85vh] md:h-[620px] flex flex-col">
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-zinc-800">
                <h2 class="text-base font-bold text-zinc-200 flex items-center gap-2">
                    @icons.Icon(icons.GetIcon("config"), "w-4 h-4 " + icons.GetColor("config")) Configurações
                </h2>
                <button @click="$store.settings.close()"
                    class="text-zinc-500 hover:text-white transition-colors text-xl leading-none">
                    &times;
                </button>
            </div>

            <!-- Wrapper for side-by-side tabs and content on desktop -->
            <div class="flex flex-col md:flex-row flex-1 overflow-hidden">
                <!-- Tabs -->
                <div class="settings-tabs-container flex flex-col gap-1 px-6 md:px-3 pt-4 md:py-6 border-b md:border-b-0 md:border-r border-zinc-800 overflow-x-auto md:overflow-x-visible md:overflow-y-auto scroll-smooth whitespace-nowrap flex-nowrap md:w-44 shrink-0"
                    style="-webkit-overflow-scrolling:touch;">
                    <button @click="$store.settings.openTab('arquivamento')"
                        :class="$store.settings.activeTab === 'arquivamento' ? 'text-white border-sky-500 bg-sky-500/5' : 'text-zinc-400 border-transparent hover:text-zinc-200 hover:bg-zinc-800/30'"
                        class="px-4 py-2 md:px-3.5 md:py-2 text-sm font-semibold border-l-2 border-b-0 md:text-left transition-all flex items-center gap-2 rounded-none">
                        @icons.Icon(icons.GetIcon("arquivamento"), "w-4 h-4 " + icons.GetColor("arquivamento")) Arquivamento
                    </button>
                    <button @click="$store.settings.openTab('restaurar')"
                        :class="$store.settings.activeTab === 'restaurar' ? 'text-white border-sky-500 bg-sky-500/5' : 'text-zinc-400 border-transparent hover:text-zinc-200 hover:bg-zinc-800/30'"
                        class="px-4 py-2 md:px-3.5 md:py-2 text-sm font-semibold border-l-2 border-b-0 md:text-left transition-all flex items-center gap-2 rounded-none">
                        @icons.Icon(icons.GetIcon("restaurar"), "w-4 h-4 " + icons.GetColor("restaurar")) Restaurar
                    </button>
                    <button @click="$store.settings.openTab('backup')"
                        :class="$store.settings.activeTab === 'backup' ? 'text-white border-sky-500 bg-sky-500/5' : 'text-zinc-400 border-transparent hover:text-zinc-200 hover:bg-zinc-800/30'"
                        class="px-4 py-2 md:px-3.5 md:py-2 text-sm font-semibold border-l-2 border-b-0 md:text-left transition-all flex items-center gap-2 rounded-none">
                        @icons.Icon(icons.GetIcon("backup"), "w-4 h-4 " + icons.GetColor("backup")) Backup
                    </button>
                    <button @click="$store.settings.openTab('rotina')"
                        :class="$store.settings.activeTab === 'rotina' ? 'text-white border-sky-500 bg-sky-500/5' : 'text-zinc-400 border-transparent hover:text-zinc-200 hover:bg-zinc-800/30'"
                        class="px-4 py-2 md:px-3.5 md:py-2 text-sm font-semibold border-l-2 border-b-0 md:text-left transition-all flex items-center gap-2 rounded-none">
                        @icons.Icon(icons.GetIcon("settings-rotina"), "w-4 h-4 " + icons.GetColor("settings-rotina")) Rotina
                    </button>
                    <button @click="$store.settings.openTab('colunas')"
                        :class="$store.settings.activeTab === 'colunas' ? 'text-white border-sky-500 bg-sky-500/5' : 'text-zinc-400 border-transparent hover:text-zinc-200 hover:bg-zinc-800/30'"
                        class="px-4 py-2 md:px-3.5 md:py-2 text-sm font-semibold border-l-2 border-b-0 md:text-left transition-all flex items-center gap-2 rounded-none">
                        @icons.Icon(icons.GetIcon("colunas"), "w-4 h-4 " + icons.GetColor("colunas")) Colunas
                    </button>
                </div>

            <!-- Tab Content -->
            <div class="flex-1 overflow-y-auto px-6 py-5 space-y-6">
                <!-- Arquivamento Tab -->
                <div x-show="$store.settings.activeTab === 'arquivamento'" class="space-y-6">
                    <p class="text-sm text-zinc-400">
                        Selecione filtros para encontrar notas, marque quais arquivar e clique em "Arquivar Selecionadas".
                        As notas serão zipadas e movidas para a pasta de arquivos mortos.
                    </p>

                    <form id="bulk-archive-form" hx-post="/api/bulk-delete" hx-target="#bulk-preview-area">
                        <input type="hidden" name="preview" value="true" />
                        <!-- Filtro: Por Tag -->
                        <div class="bg-zinc-800/50 rounded-xl p-4 border border-zinc-700/50 mb-6">
                            <label class="block text-sm font-semibold text-zinc-200 mb-3">Filtrar por tag</label>
                            <label class="block text-xs text-zinc-500 mb-2">Notas que contenham uma ou mais tags (separadas por vírgula):</label>
                            <input type="text" name="tag_name" id="filter-tag-names" placeholder="ex: temporario, rascunho, lixo"
                                class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-sm text-zinc-200 placeholder:text-zinc-500 focus:outline-hidden focus:border-sky-500 transition-colors" />
                            <input type="hidden" name="by_tag" value="true" />
                        </div>

                        <button type="submit"
                            class="w-full py-2.5 rounded-xl bg-sky-600 hover:bg-sky-700 text-white text-sm font-bold transition-colors">
                            🔍 Previsualizar Notas
                        </button>
                    </form>

                    <div id="bulk-preview-area" class="mt-6"></div>

                    <!-- Cleanup orphan images -->
                    <div class="border-t border-zinc-800 pt-6 mt-6">
                        <p class="text-[10px] text-zinc-600 mb-3">
                            Imagens enviadas pelo editor que não são mais referenciadas por nenhuma nota podem ser removidas para liberar espaço.
                        </p>
                        <div id="cleanup-result">
                            <button hx-post="/api/cleanup-images" hx-target="#cleanup-result"
                                class="w-full py-2 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-400 hover:text-white text-xs font-semibold transition-colors">
                                🧹 Limpar imagens órfãs
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Restaurar Tab -->
                <div x-show="$store.settings.activeTab === 'restaurar'" class="space-y-6">
                    <p class="text-sm text-zinc-400">
                        Aqui estão os pacotes de arquivos que você arquivou anteriormente. 
                        Ao restaurar, eles voltarão para os diretórios originais e ficarão disponíveis nas buscas.
                    </p>

                    <div id="restore-result-area" hx-get="/api/archives" hx-trigger="load, reload-archives from:body">
                        <div class="text-center py-6">
                            <div class="animate-spin h-5 w-5 border-2 border-zinc-600 border-t-transparent rounded-full mx-auto mb-3"></div>
                            <p class="text-xs text-zinc-500">Carregando arquivos mortos...</p>
                        </div>
                    </div>
                </div>

                <!-- Backup Tab -->
                <div x-show="$store.settings.activeTab === 'backup'" class="space-y-6">
                    <p class="text-sm text-zinc-400">
                        Escolha o tipo de backup ideal para você. O backup rápido contém apenas as notas (incluindo desenhos). O completo inclui também arquivos pesados.
                        Arquivos da pasta
                        <code class="text-zinc-500">archives/</code> não são
                        incluídos.
                        Já o <strong class="text-amber-400">Backup Total</strong> guarda o banco inteiro
                        (configurações e notas) e é o único que pode ser <strong class="text-amber-400">restaurado</strong>.
                    </p>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- Apenas Notas -->
                        <div class="bg-zinc-800/50 rounded-xl p-5 border border-zinc-700/50 flex flex-col justify-between text-center">
                            <div>
                                <div class="text-4xl mb-3">📄</div>
                                <p class="text-sm text-zinc-300 font-bold mb-1">
                                    Apenas Notas (Rápido)
                                </p>
                                <p class="text-xs text-zinc-500 mb-4">
                                    Textos em markdown, meta-dados, dados estruturados.
                                </p>
                            </div>
                            <a id="backup-download-notas-btn" href="/api/backup?full=false" download
                                class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold transition-colors w-full mt-2"
                                onclick="
                                        this.classList.add('opacity-50');
                                        let originalText = this.innerHTML;
                                        this.innerHTML = '⏳ Gerando...';
                                        setTimeout(() => {
                                            this.classList.remove('opacity-50');
                                            this.innerHTML = originalText;
                                        }, 3000);
                                    ">
                                ⬇️ Baixar Rápido
                            </a>
                        </div>

                        <!-- Backup Completo -->
                        <div class="bg-zinc-800/50 rounded-xl p-5 border border-zinc-700/50 flex flex-col justify-between text-center">
                            <div>
                                <div class="text-4xl mb-3">💾</div>
                                <p class="text-sm text-zinc-300 font-bold mb-1">
                                    Backup Completo
                                </p>
                                <p class="text-xs text-zinc-500 mb-4">
                                    Tudo: notas e os arquivos/anexos pesados em disco.
                                </p>
                            </div>
                            <a id="backup-download-full-btn" href="/api/backup?full=true" download
                                class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-700 text-white text-sm font-bold transition-colors w-full mt-2"
                                onclick="
                                        this.classList.add('opacity-50');
                                        let originalText = this.innerHTML;
                                        this.innerHTML = '⏳ Gerando...';
                                        setTimeout(() => {
                                            this.classList.remove('opacity-50');
                                            this.innerHTML = originalText;
                                        }, 10000);
                                    ">
                                ⬇️ Baixar Completo
                            </a>
                        </div>

                        <!-- Backup Total: exportável E restaurável -->
                        <div class="sm:col-span-2 bg-zinc-800/50 rounded-xl p-5 border border-amber-500/40 flex flex-col justify-between text-center">
                            <div>
                                <div class="text-4xl mb-3">🧩</div>
                                <p class="text-sm text-zinc-300 font-bold mb-1">
                                    Backup Total (exportar e restaurar)
                                </p>
                                <p class="text-xs text-zinc-500 mb-4">
                                    Tudo: notas, configurações e <strong class="text-zinc-400">todos</strong> os arquivos
                                    (inclusive <code class="text-zinc-500">archives/</code>). É o único que pode ser importado de volta.
                                </p>
                            </div>
                            <a id="backup-download-total-btn" href="/api/backup/total" download
                                class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white text-sm font-bold transition-colors w-full mt-2"
                                onclick="
                                        this.classList.add('opacity-50');
                                        let originalText = this.innerHTML;
                                        this.innerHTML = '⏳ Gerando...';
                                        setTimeout(() => {
                                            this.classList.remove('opacity-50');
                                            this.innerHTML = originalText;
                                        }, 10000);
                                    ">
                                ⬇️ Baixar Backup Total
                            </a>
                        </div>
                    </div>

                    <!-- Restaurar: substituição total a partir de um Backup Total -->
                    <div class="rounded-xl border border-red-500/30 bg-red-500/5 p-5">
                        <p class="text-sm font-bold text-red-300 mb-1">♻️ Restaurar um Backup Total</p>
                        <p class="text-xs text-red-200/80 leading-relaxed mb-4">
                            <strong>Substitui tudo</strong> pelo conteúdo do arquivo: notas, configurações
                            e arquivos. O estado atual é movido para uma quarentena (por segurança) antes de aplicar.
                            Ao terminar, o servidor reinicia sozinho — aguarde alguns segundos e recarregue a página.
                        </p>
                        <form hx-post="/api/restore" hx-encoding="multipart/form-data"
                            hx-target="#restore-result-area" hx-swap="innerHTML"
                            hx-confirm="Isso SUBSTITUI todas as notas, arquivos e configurações atuais pelo conteúdo do backup. Continuar?"
                            class="flex flex-col sm:flex-row gap-3 sm:items-center"
                            onsubmit="var b = this.querySelector('button[type=submit]'); b.textContent = '⏳ Restaurando...';">
                            <input type="file" name="file" accept=".zip,application/zip" required
                                class="block w-full text-xs text-zinc-300 file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-amber-600 file:text-white file:text-xs file:font-bold hover:file:bg-amber-700 cursor-pointer" />
                            <button type="submit"
                                class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white text-sm font-bold transition-colors shrink-0">
                                ♻️ Restaurar
                            </button>
                        </form>
                        <div id="restore-result-area" class="mt-3"></div>
                    </div>

                    <div class="bg-zinc-800/30 rounded-xl p-4 border border-zinc-700/50">
                        <p class="text-xs text-zinc-500 leading-relaxed">
                            <strong class="text-zinc-400">O que é incluído no Completo:</strong><br />
                            Além das notas (<code class="text-zinc-500">notes</code>):<br />
                            📕 PDFs da pasta <code class="text-zinc-500">pdfs/</code><br />
                            📦 Anexos da pasta <code class="text-zinc-500">attachments/</code>
                        </p>
                    </div>
                </div>


                <!-- Rotina Tab -->
                <div x-show="$store.settings.activeTab === 'rotina'" class="space-y-6">
                    <p class="text-sm text-zinc-400">
                        A Rotina é a linha do tempo das atividades do seu dia. Aqui você pode
                        desligá-la temporariamente: o ícone some do cabeçalho e a página
                        <code class="text-sky-400">/rotina</code> deixa de abrir. Nenhuma atividade
                        é apagada — ao religar, tudo volta como estava.
                    </p>

                    <div x-data="rotinaConfig()" data-rotina-enabled={ featureflags.BoolString(flags.Rotina) }
                        data-rotina-native={ featureflags.BoolString(flags.RotinaNativeTimeline) }
                        class="bg-zinc-800/50 rounded-xl p-4 border border-zinc-700/50 space-y-3">
                        <div class="flex items-center justify-between gap-4">
                            <div class="min-w-0">
                                <p class="text-sm font-semibold text-zinc-200">Habilitar Rotina</p>
                                <p class="text-[10px] text-zinc-500 mt-1 leading-relaxed">
                                    Exibe o ícone no cabeçalho e libera a página
                                    com a linha do tempo do dia.
                                </p>
                            </div>
                            <button type="button" role="switch" :aria-checked="enabled.toString()"
                                @click="toggle()" :disabled="saving"
                                :class="enabled ? 'bg-sky-600' : 'bg-zinc-700'"
                                class="relative inline-flex h-6 w-11 shrink-0 items-center rounded-full transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                                :title="enabled ? 'Desligar Rotina' : 'Ligar Rotina'">
                                <span :class="enabled ? 'translate-x-5' : 'translate-x-0.5'"
                                    class="inline-block h-5 w-5 transform rounded-full bg-white shadow-sm transition-transform"></span>
                            </button>
                        </div>

                        <div class="flex items-center justify-between gap-4 pt-3 border-t border-zinc-700/50">
                            <div class="min-w-0">
                                <p class="text-sm font-semibold text-zinc-200">Linha do tempo nativa</p>
                                <p class="text-[10px] text-zinc-500 mt-1 leading-relaxed">
                                    Desenha o gráfico sem o Mermaid (economiza ~3 MB por visita).
                                    Desligue para comparar com a versão antiga; a página recarrega
                                    ao trocar.
                                </p>
                            </div>
                            <button type="button" role="switch" :aria-checked="native.toString()"
                                @click="toggleNative()" :disabled="nativeSaving"
                                :class="native ? 'bg-sky-600' : 'bg-zinc-700'"
                                class="relative inline-flex h-6 w-11 shrink-0 items-center rounded-full transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                                :title="native ? 'Usar o Mermaid (versão antiga)' : 'Usar a linha do tempo nativa'">
                                <span :class="native ? 'translate-x-5' : 'translate-x-0.5'"
                                    class="inline-block h-5 w-5 transform rounded-full bg-white shadow-sm transition-transform"></span>
                            </button>
                        </div>

                        <p x-show="saved" x-transition.duration.300ms class="text-[11px] text-emerald-400 text-right">✓ Salvo!</p>
                        <p x-show="nativeSaved" x-transition.duration.300ms class="text-[11px] text-emerald-400 text-right">✓ Renderer atualizado!</p>
                        <p x-show="error" x-text="errorMsg" class="text-[11px] text-red-400 text-right"></p>
                        <p x-show="nativeError" x-text="nativeErrorMsg" class="text-[11px] text-red-400 text-right"></p>
                    </div>
                </div>

                <!-- Colunas Tab -->
                <div x-show="$store.settings.activeTab === 'colunas'" class="space-y-6">
                    <p class="text-sm text-zinc-400">
                        Controle quais campos do frontmatter podem virar coluna na tabela. Campos desmarcados não aparecem como colunas.
                    </p>

                    <!-- O conteúdo é carregado/recarregado por reloadColumnFields() a cada
                         abertura da aba (não é "intersect once": a lista depende das notas). -->
                    <div id="columns-settings-container">
                        <div class="text-center py-8">
                            <div class="animate-spin h-5 w-5 border-2 border-zinc-600 border-t-transparent rounded-full mx-auto mb-3"></div>
                            <p class="text-xs text-zinc-600">Carregando preferências de colunas...</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
    
    <script>
        document.addEventListener('alpine:init', () => {
            // Rotina (aba "Rotina"): o estado inicial vem do servidor
            // (data-rotina-enabled / data-rotina-native), então não há fetch ao
            // abrir a página.
            Alpine.data('rotinaConfig', () => ({
                enabled: true,
                native: true,
                saving: false,
                nativeSaving: false,
                saved: false,
                error: false,
                errorMsg: '',
                nativeSaved: false,
                nativeError: false,
                nativeErrorMsg: '',
                init() {
                    this.enabled = this.$el.dataset.rotinaEnabled !== '0';
                    this.native = this.$el.dataset.rotinaNative !== '0';
                },
                toggle() {
                    if (this.saving) return;
                    this.save(!this.enabled);
                },
                toggleNative() {
                    if (this.nativeSaving) return;
                    this.saveNative(!this.native);
                },
                save(next) {
                    this.saving = true;
                    this.saved = false;
                    this.error = false;
                    var body = new URLSearchParams();
                    body.append('enabled', next ? '1' : '0');
                    fetch('/api/settings/rotina', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: body.toString()
                    })
                    .then(async r => {
                        const data = await r.json().catch(() => ({}));
                        if (!r.ok) throw new Error(data.error || ('HTTP ' + r.status));
                        this.enabled = !!data.enabled;
                        if (typeof window.applyRotinaNav === 'function') {
                            window.applyRotinaNav(this.enabled);
                        }
                        this.saved = true;
                        setTimeout(() => this.saved = false, 3000);
                        // Desligar enquanto está na própria página: sai para a home.
                        if (!this.enabled && window.location.pathname === '/rotina') {
                            window.location.href = '/';
                        }
                    })
                    .catch(e => {
                        this.error = true;
                        this.errorMsg = e.message || 'Erro ao salvar';
                        setTimeout(() => this.error = false, 5000);
                    })
                    .finally(() => { this.saving = false; });
                },
                saveNative(next) {
                    this.nativeSaving = true;
                    this.nativeSaved = false;
                    this.nativeError = false;
                    var body = new URLSearchParams();
                    body.append('native', next ? '1' : '0');
                    fetch('/api/settings/rotina', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: body.toString()
                    })
                    .then(async r => {
                        const data = await r.json().catch(() => ({}));
                        if (!r.ok) throw new Error(data.error || ('HTTP ' + r.status));
                        this.native = !!data.timeline_native;
                        this.nativeSaved = true;
                        setTimeout(() => this.nativeSaved = false, 3000);
                        // O renderer é escolhido no servidor (inclusive qual
                        // script carregar), então só um reload aplica a troca.
                        if (window.location.pathname === '/rotina') {
                            window.location.reload();
                        }
                    })
                    .catch(e => {
                        this.nativeError = true;
                        this.nativeErrorMsg = e.message || 'Erro ao salvar';
                        setTimeout(() => this.nativeError = false, 5000);
                    })
                    .finally(() => { this.nativeSaving = false; });
                }
            }));
        });

        // Mostra/esconde o ícone da Rotina no cabeçalho (desktop e mobile) sem
        // recarregar a página. O elemento é renderizado sempre; o servidor já
        // marca display:none quando a flag está desligada.
        window.applyRotinaNav = function (enabled) {
            document.querySelectorAll('[data-nav-rotina]').forEach(function (el) {
                el.style.display = enabled ? '' : 'none';
            });
        };

        // Colunas: recarrega a lista de campos do frontmatter a cada abertura da
        // aba (não pode ser "intersect once" — a lista é dinâmica e depende das
        // notas). Chamado pelo Alpine store ($store.settings.openTab).
        window.reloadColumnFields = function () {
            var container = document.getElementById("columns-settings-container");
            if (!container) return;
            container.innerHTML = '<div class="text-center py-8">' +
                '<div class="animate-spin h-5 w-5 border-2 border-zinc-600 border-t-transparent rounded-full mx-auto mb-3"></div>' +
                '<p class="text-xs text-zinc-600">Carregando preferências de colunas...</p></div>';
            fetch("/api/settings/columns")
                .then(function (r) {
                    if (!r.ok) throw new Error("HTTP " + r.status);
                    return r.text();
                })
                .then(function (html) {
                    container.innerHTML = html;
                    // O conteúdo é injetado via innerHTML (fora do hx-swap): o HTMX
                    // não inicializa sozinho os atributos hx-* (ex: hx-post do form).
                    // Sem htmx.process o botão "Salvar Colunas" não envia nada.
                    if (window.htmx) htmx.process(container);
                })
                .catch(function (e) {
                    container.innerHTML = '<p class="text-xs text-red-400">Erro ao carregar preferências de colunas: ' + e.message + '</p>';
                });
        };

    </script>
}
